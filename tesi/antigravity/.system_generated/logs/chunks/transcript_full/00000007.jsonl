ted_data = sorted(data)\n41:     k = (len(sorted_data) - 1) * (p / 100.0)\n42:     f = math.floor(k)\n43:     c = math.ceil(k)\n44:     if f == c:\n45:         return round(sorted_data[int(k)], 4)\n46:     d0 = sorted_data[int(f)] * (c - k)\n47:     d1 = sorted_data[int(c)] * (k - f)\n48:     return round(d0 + d1, 4)\n49: \n50: \n51: def calculate_stats(values: List[float]) -> Dict[str, float]:\n52:     if not values:\n53:         return {'avg': 0.0, 'p50': 0.0, 'p95': 0.0, 'min': 0.0, 'max': 0.0, 'std': 0.0}\n54:     avg = sum(values) / len(values)\n55:     variance = sum((x - avg) ** 2 for x in values) / len(values)\n56:     return {\n57:         'avg': round(avg, 4),\n58:         'p50': percentile(values, 50),\n59:         'p95': percentile(values, 95),\n60:         'min': round(min(values), 4),\n61:         'max': round(max(values), 4),\n62:         'std': round(math.sqrt(variance), 4),\n63:     }\n64: \n65: \n66: def get_system_metrics() -> Dict[str, int]:\n67:     mem_total, mem_avail = 0, 0\n68:     try:\n69:         with open('/proc/meminfo', 'r') as f:\n70:             for line in f:\n71:                 if line.startswith('MemTotal:'):\n72:                     mem_total = int(line.split()[1]) // 1024\n73:                 elif line.startswith('MemAvailable:'):\n74:                     mem_avail = int(line.split()[1]) // 1024\n75:     except Exception:\n76:         pass\n77:     used_ram = mem_total - mem_avail\n78:     return {'used_ram_mb': used_ram, 'free_ram_mb': mem_avail}\n79: \n80: \n81: def build_challenge_payload(team_k: int, num_containers: int) -> Dict[str, Any]:\n82:     containers = []\n83:     verify_commands = []\n84:     for i in range(num_containers):\n85:         c_name = f'app{i+1}'\n86:         containers.append({\n87:             'name': c_name,\n88:             'image': 'alpine',\n89:             'ip_suffix': i + 2,\n90:             'limits_cpu': '1',\n91:             'limits_memory': '128MB'\n92:         })\n93:         verify_commands