        t0 = time.perf_counter()\n216:         r = await self.client.delete_team(team_k=k)\n217:         return k, round(time.perf_counter() - t0, 4), r.status_code\n218: \n219:     # --------------------------------------------------------------------------\n220:     # Core Execution of a Single (M, N) Scenario or Cycle\n221:     # --------------------------------------------------------------------------\n222:     async def execute_barrier_scenario(\n223:         self,\n224:         test_name: str,\n225:         test_type: str,\n226:         m: int,\n227:         n: int,\n228:         cycle_idx: Optional[int] = None,\n229:         clean_before: bool = True,\n230:     ) -> Tuple[Dict[str, Any], List[Dict[str, Any]]]:\n231:         team_ids = list(range(1, m + 1))\n232:         if clean_before:\n233:             await self.ensure_clean_environment(team_ids)\n234: \n235:         ram_baseline = get_system_metrics()['used_ram_mb']\n236: \n237:         # SUB-STAGE 1: Provision M Teams in parallel & wait\n238:         t_prov_start = time.perf_counter()\n239:         prov_results = await asyncio.gather(*[\n240:             self._timed_create_team(k, f'{test_name} Team {k}')\n241:             for k in team_ids\n242:         ])\n243:         prov_wall_sec = round(time.perf_counter() - t_prov_start, 4)\n244:         prov_times_map = {k: elapsed for k, elapsed, _ in prov_results}\n245: \n246:         # SUB-STAGE 2: Deploy M x N Containers in parallel & wait\n247:         payloads = {k: build_challenge_payload(team_k=k, num_containers=n) for k in team_ids}\n248:         t_dep_start = time.perf_counter()\n249:         dep_results = await asyncio.gather(*[\n250:             self._timed_deploy(k, payloads[k])\n251:             for k in team_ids\n252:         ])\n253:         dep_wall_sec = round(time.perf_counter() - t_dep_start, 4)\n254:         ram_after_deploy = get_system_metrics()['used_ram_mb']\n255: \n256:         # Short settle pause so ZFS/network state stabilizes before Verify burst\n257:         await asyncio.sleep(1.0)\n258: \n259:         # SUB-STAGE 3: Verify M Teams in parallel & wait\n260:         t_ver_start = time.perf_counter()\n261:         ver_results = await asyncio.gather(*[\n262:             self._timed_verify(k, payloads[k])\n263:             for k in team_ids\n264:         ])\n265:         ver_wall_sec = round(time.perf_counter() - t_ver_start, 4)\n266:         ram_after_verify = get_system_metrics()['used_ram_mb']\n267: \n268:         # SUB-STAGE 4: Teardown all M x N containers & M teams in parallel & wait\n269:         t_tear_start = time.perf_counter()\n270:         t_mach_start = time.perf_counter()\n271:         tear_mach_results = await asyncio.gather(*[\n272:             self._timed_teardown_machines(k)\n273:             for k in team_ids\n274:         ])\n275:         tear_machines_wall_sec = round(time.perf_counter() - t_mach_start, 4)\n276: \n277:         t_team_start = time.perf_counter()\n278:         tear_team_results = await asyncio.gather(*[\n279:             self._timed_delete_team(k)\n280:             for k in team_ids\n281:         ])\n282:         tear_teams_wall_sec = round(time.perf_counter() - t_team_start, 4)\n283:         teardown_wall_sec = round(time.perf_counter() - t_tear_start, 4)\n284:         ram_after_teardown = get_system_metrics()['used_ram_mb']\n285: \n286:         tear_mach_map = {k: elapsed for k, elapsed, _ in tear_mach_results}\n287:         tear_team_map = {k: elapsed for k, elapsed, _ in tear_team_results}\n288: \n289:         # Parse per-team metrics\n290:         dep_map = {k: (elapsed, r) for k, elapsed, r in dep_results}\n291:         ver_map = {k: (elapsed, r) for k, elapsed, r in ver_results}\n292: \n293:         raw_rows: List[Dict[str, Any]] = []\n294:         errors: List[str] = []\n295:         pass_count = 0\n296: \n297:         for k in team_ids:\n298:             prov_sec = prov_times_map[k]\n299:             dep_http_sec, r_dep = dep_map[k]\n300:             ver_http_sec, r_ver = ver_map[k]\n301:             tm_sec = tear_mach_map[k]\n302:             tt_sec = tear_team_map[k]\n303: \n304:             dep_st = {}\n305:             if r_dep.status_code in (200, 201):\n306:                 dep_st = r_dep.json().get('step_timings', {})\n307:             else:\n308:                 errors.append(f'Team {k} Deploy HTTP {r_dep.status_code}: {r_dep.text[:120]}')\n309: \n310:             ver_st = {}\n311:             sb = {}\n312:             cl = {}\n313:             ver_passed = False\n314:             if r_ver.status_code == 200:\n315:                 v_json = r_ver.json()\n316:                 ver_passed = bool(v_json.get('passed'))\n317:                 if ver_passed:\n318:                     pass_count += 1\n319:                 ver_st = v_json.get('details', {}).get('step_timings', {})\n320:                 sb = ver_st.get('sandbox_setup', {})\n321:                 cl = ver_st.get('cleanup', {})\n322:             else:\n323:                 errors.append(f'Team {k} Verify HTTP {r_ver.status_code}: {r_ver.text[:150]}')\n324:                 logger.error('[%s] Team %d verify error: %s', test_name, k, r_ver.text[:200])\n325: \n326:             row = {\n327:                 'test_name': test_name,\n328:                 'test_type': test_type,\n329:                 'teams_m': m,\n330:                 'containers_n': n,\n331:                 'cycle': cycle_idx if cycle_idx is not None else 1,\n332:                 'team_k': k,\n333:                 'http_deploy_status': r_dep.status_code,\n334:                 'http_verify_status': r_ver.status_code,\n335:                 'verify_passed': int(ver_passed),\n336:                 # Sub-stage 1: Provision\n337:                 'provision_team_sec': prov_sec,\n338:                 # Sub-stage 2: Deploy\n339:                 'deploy_http_sec': dep_http_sec,\n340:                 'deploy_total_sec': dep_st.get('total_deploy_sec', dep_http_sec),\n341:                 'deploy_validation_sec': dep_st.get('validation_sec', 0.0),\n342:                 'deploy_create_sec': dep_st.get('total_create_sec', 0.0),\n343:                 'deploy_push_sec': dep_st.get('total_push_sec', 0.0),\n344:                 'deploy_start_sec': dep_st.get('total_start_sec', 0.0),\n345:                 'deploy_runtime_net_sec': dep_st.get('total_runtime_net_sec', 0.0),\n346:                 'deploy_db_record_sec': dep_st.get('total_db_record_sec', 0.0),\n347:                 # Sub-stage 3: Verify\n348:                 'verify_http_sec': ver_http_sec,\n349:                 'verify_total_sec': ver_st.get('total_verify_lifecycle_sec', ver_http_sec if r_ver.status_code == 200 else 0.0),\n350:                 'verify_setup_total_sec': sb.get('total_setup_sec', 0.0),\n351:                 'verify_ovn_net_create_sec': sb.get('ovn_network_create_sec', 0.0),\n352:                 'verify_cow_clone_sec': sb.get('total_clone_time_sec', 0.0),\n353:                 'verify_clone_connect_sec': sb.get('total_connect_time_sec', 0.0),\n354:                 'verify_clone_start_sec': sb.get('total_start_time_sec', 0.0),\n355:                 'verify_clone_runtime_net_sec': sb.get('total_runtime_net_sec', 0.0),\n356:                 'verify_runner_sec': sb.get('verifier_runner_sec', 0.0),\n357:                 'verify_readiness_sec': ver_st.get('readiness_sec', 0.0),\n358:                 'verify_commands_sec': ver_st.get('verify_commands_sec', 0.0),\n359:                 'verify_cleanup_clones_sec': cl.get('clones_teardown_sec', 0.0),\n360:                 'verify_cleanup_ovn_net_sec': cl.get('ovn_network_delete_sec', 0.0),\n361:                 'verify_cleanup_total_sec': cl.get('total_cleanup_sec', 0.0),\n362:                 # Sub-stage 4: Teardown\n363:                 'teardown_machines_sec': tm_sec,\n364:                 'teardown_team_sec': tt_sec,\n365:                 'teardown_total_sec': round(tm_sec + tt_sec, 4),\n366:             }\n367:             raw_rows.append(row)\n368: \n369:         summary = self._aggregate_rows_to_summary(\n370:             test_name=test_name,\n371:             test_type=test_type,\n372:             m=m,\n373:             n=n,\n374:             cycles=1,\n375:             raw_rows=raw_rows,\n376:             prov_wall_sec=prov_wall_sec,\n377:             dep_wall_sec=dep_wall_sec,\n378:             ver_wall_sec=ver_wall_sec,\n379:             tear_machines_wall_sec=tear_machines_wall_sec,\n380:             tear_teams_wall_sec=tear_teams_wall_sec,\n381:             teardown_wall_sec=teardown_wall_sec,\n382:             ram_baseline=ram_baseline,\n383:             ram_after_deploy=ram_after_deploy,\n384:             ram_after_verify=ram_after_verify,\n385:             ram_after_teardown=ram_after_teardown,\n386:             errors=errors,\n387:         )\n388:         return summary, raw_rows\n389: \n390:     def _aggregate_rows_to_summary(\n391:         self,\n392:         test_name: str,\n393:         test_type: str,\n394:         m: int,\n395:         n: int,\n396:         cycles: int,\n397:         raw_rows: List[Dict[str, Any]],\n398:         prov_wall_sec: float,\n399:         dep_wall_sec: float,\n400:         ver_wall_sec: float,\n401:         tear_machines_wall_sec: float,\n402:         tear_teams_wall_sec: float,\n403:         teardown_wall_sec: float,\n404:         ram_baseline: int,\n405:         ram_after_deploy: int,\n406:         ram_after_verify: int,\n407:         ram_after_teardown: int,\n408:         errors: List[str],\n409:     ) -> Dict[str, Any]:\n410:         ok_dep = [r for r in raw_rows if r['http_deploy_status'] in (200, 201)]\n411:         ok_ver = [r for r in raw_rows if r['http_verify_status'] == 200 and r['verify_passed'] == 1]\n412:         total_attempts = len(raw_rows)\n413:         passed_count = len(ok_ver)\n414:         failed_count = total_attempts - passed_count\n415: \n416:         def col_stats(rows: List[Dict[str, Any]], key: str) -> Dict[str, float]:\n417:             return calculate_stats([float(r[key]) for r in rows])\n418: \n419:         return {\n420:             'test_name': test_name,\n421:             'test_type': test_type,\n422:             'teams_count': m,\n423:             'containers_per_team': n,\n424:             'cycles': cycles,\n425:             'total_containers_live': m * n,\n426:             'peak_containers_verify': 2 * m * n,\n427:             'passed_count': passed_count,\n428:             'failed_count': failed_count,\n429:             'passed_ratio': f'{passed_count}/{total_attempts}',\n430:             'pass_rate_pct': round((passed_count / total_attempts) * 100.0, 2) if total_attempts else 0.0,\n431:             # Wall-clock times per barrier sub-stage\n432:             'provision_wall_sec': prov_wall_sec,\n433:             'deploy_wall_sec': dep_wall_sec,\n434:             'verify_wall_sec': ver_wall_sec,\n435:             'teardown_machines_wall_sec': tear_machines_wall_sec,\n436:             'teardown_teams_wall_sec': tear_teams_wall_sec,\n437:             'teardown_wall_sec': teardown_wall_sec,\n438:             # Macro stats\n439:             'provision_stats': col_stats(raw_rows, 'provision_team_sec'),\n440:             'deploy_stats': col_stats(ok_dep, 'deploy_total_sec'),\n441:             'verify_stats': col_stats(ok_ver, 'verify_total_sec'),\n442:             'teardown_machines_stats': col_stats(raw_rows, 'teardown_machines_sec'),\n443:             'teardown_team_stats': col_stats(raw_rows, 'teardown_team_sec'),\n444:             'teardown_total_stats': col_stats(raw_rows, 'teardown_total_sec'),\n445:             # Micro-phase stats\n446:             'phase_stats': {\n447:                 # Deploy micro-phases\n448:                 'deploy_validation_sec': col_stats(ok_dep, 'deploy_validation_sec'),\n449:                 'deploy_create_sec': col_stats(ok_dep, 'deploy_create_sec'),\n450:                 'deploy_push_sec': col_stats(ok_dep, 'deploy_push_sec'),\n451:                 'deploy_start_sec': col_stats(ok_dep, 'deploy_start_sec'),\n452:                 'deploy_runtime_net_sec': col_stats(ok_dep, 'deploy_runtime_net_sec'),\n453:                 'deploy_db_record_sec': col_stats(ok_dep, 'deploy_db_record_sec'),\n454:                 # Verify micro-phases\n455:                 'verify_setup_total_sec': col_stats(ok_ver, 'verify_setup_total_sec'),\n456:                 'ovn_create_sec': col_stats(ok_ver, 'verify_ovn_net_create_sec'),\n457:                 'cow_clone_sec': col_stats(ok_ver, 'verify_cow_clone_sec'),\n458:                 'clone_connect_sec': col_stats(ok_ver, 'verify_clone_connect_sec'),\n459:                 'clone_start_sec': col_stats(ok_ver, 'verify_clone_start_sec'),\n460:                 'clone_runtime_net_sec': col_stats(ok_ver, 'verify_clone_runtime_net_sec'),\n461:                 'verify_runner_sec': col_stats(ok_ver, 'verify_runner_sec'),\n462:                 'verify_readiness_sec': col_stats(ok_ver, 'verify_readiness_sec'),\n463:                 'verify_cmds_sec': col_stats(ok_ver, 'verify_commands_sec'),\n464:                 'cleanup_clones_sec': col_stats(ok_ver, 'verify_cleanup_clones_sec'),\n465:                 'cleanup_ovn_net_sec': col_stats(ok_ver, 'verify_cleanup_ovn_net_sec'),\n466:                 'cleanup_sec': col_stats(ok_ver, 'verify_cleanup_total_sec'),\n467:             },\n468:             # Memory snapshots across barriers\n469:             'ram_baseline_mb': ram_baseline,\n470:             'ram_after_deploy_mb': ram_after_deploy,\n471:             'ram_after_verify_mb': ram_after_verify,\n472:             'ram_after_teardown_mb': ram_after_teardown,\n473:             'ram_used_mb': ram_after_verify,\n474:             'errors': errors,\n475:         }\n476: \n477:     # --------------------------------------------------------------------------\n478:     # TEST 1: Single-Team Baseline & Micro-Phase Profiling\n479:     # --------------------------------------------------------------------------\n480:     async def run_test_1(self, cycles: int = 10):\n481:         logger.info('===============================================================')\n482:         logger.info('TEST 1: SINGLE-TEAM BASELINE & MICRO-PHASE PROFILING (M=1, N=1, %d cycles)', cycles)\n483:         logger.info('===============================================================')\n484: \n485:         await self.ensure_clean_environment([1])\n486:         all_cycle_rows: List[Dict[str, Any]] = []\n487:         all_errors: List[str] = []\n488:         prov_walls, dep_walls, ver_walls, tm_walls, tt_walls, tear_walls = [], [], [], [], [], []\n489:         ram_base_list, ram_dep_list, ram_ver_list, ram_tear_list = [], [], [], []\n490: \n491:         for c in range(1, cycles + 1):\n492:             logger.info('[Test 1] Cycle %d/%d starting...', c, cycles)\n493:             summary_c, rows_c = await self.execute_barrier_scenario(\n494:                 test_name='Test 1 (Baseline M=1, N=1)',\n495:                 test_type='test_1_baseline',\n496:                 m=1,\n497:                 n=1,\n498:                 cycle_idx=c,\n499:                 clean_before=False,\n500:             )\n501:             all_cycle_rows.extend(rows_c)\n502:             all_errors.extend(summary_c['errors'])\n503:             prov_walls.append(summary_c['provision_wall_sec'])\n504:             dep_walls.append(summary_c['deploy_wall_sec'])\n505:             ver_walls.append(summary_c['verify_wall_sec'])\n506:             tm_walls.append(summary_c['teardown_machines_wall_sec'])\n507:             tt_walls.append(summary_c['teardown_teams_wall_sec'])\n508:             tear_walls.append(summary_c['teardown_wall_sec'])\n509:             ram_base_list.append(summary_c['ram_baseline_mb'])\n510:             ram_dep_list.append(summary_c['ram_after_deploy_mb'])\n511:             ram_ver_list.append(summary_c['ram_after_verify_mb'])\n512:             ram_tear_list.append(summary_c['ram_after_teardown_mb'])\n513:             logger.info('[Test 1] Cycle %d/%d finished: Prov=%.3fs, Deploy=%.3fs, Verify=%.3fs, Teardown=%.3fs',\n514:                         c, cycles, summary_c['provision_wall_sec'], summary_c['deploy_wall_sec'],\n515:                         summary_c['verify_wall_sec'], summary_c['teardown_wall_sec'])\n516: \n517:         final_summary = self._aggregate_rows_to_summary(\n518:             test_name='Test 1 (Baseline M=1, N=1)',\n519:             test_type='test_1_baseline',\n520:             m=1,\n521:             n=1,\n522:             cycles=cycles,\n523:             raw_rows=all_cycle_rows,\n524:             prov_wall_sec=round(sum(prov_walls) / len(prov_walls), 4),\n525:             dep_wall_sec=round(sum(dep_walls) / len(dep_walls), 4),\n526:             ver_wall_sec=round(sum(ver_walls) / len(ver_walls), 4),\n527:             tear_machines_wall_sec=round(sum(tm_walls) / len(tm_walls), 4),\n528:             tear_teams_wall_sec=round(sum(tt_walls) / len(tt_walls), 4),\n529:             teardown_wall_sec=round(sum(tear_walls) / len(tear_walls), 4),\n530:             ram_baseline=int(sum(ram_base_list) / len(ram_base_list)),\n531:             ram_after_deploy=int(sum(ram_dep_list) / len(ram_dep_list)),\n532:             ram_after_verify=int(sum(ram_ver_list) / len(ram_ver_list)),\n533:             ram_after_teardown=int(sum(ram_tear_list) / len(ram_tear_list)),\n534:             errors=all_errors,\n535:         )\n536:         self.upsert_result(final_summary, all_cycle_rows)\n537:         logger.info('[+] Test 1 Completed and flushed to CSV/Markdown.')\n538:         return final_summary\n539: \n540:     # --------------------------------------------------------------------------\n541:     # TIERED STRESS TEST MATRIX (Also covers Test 3 on N=2 slice)\n542:     # --------------------------------------------------------------------------\n543:     async def run_tiered_matrix(self, teams: List[int], containers: List[int]):\n544:         logger.info('===============================================================')\n545:         logger.info('TIERED STRESS TEST MATRIX (M in %s, N in %s)', teams, containers)\n546:         logger.info('===============================================================')\n547: \n548:         for m in teams:\n549:             for n in containers:\n550:                 test_name = f'Tier M={m} N={n}'\n551:                 logger.info('>>> STARTING TIER: M=%d teams, N=%d containers/team (Peak Instances: %d) <<<',\n552:                             m, n, 2 * m * n)\n553:                 summary, raw_rows = await self.execute_barrier_scenario(\n554:                     test_name=test_name,\n555:                     test_type='matrix_and_test3' if n == 2 else 'matrix',\n556:                     m=m,\n557:                     n=n,\n558:                     cycle_idx=1,\n559:                     clean_before=True,\n560:                 )\n561:                 self.upsert_result(summary, raw_rows)\n562:                 logger.info(\n563:                     '[+] Completed %s (Pass=%s): ProvWall=%.3fs, DeployWall=%.3fs, VerifyWall=%.3fs (p95=%.3fs), TeardownWall=%.3fs, RAM=%dMB',\n564:                     test_name, summary['passed_ratio'], summary['provision_wall_sec'],\n565:                     summary['deploy_wall_sec'], summary['verify_wall_sec'],\n566:                     summary['verify_stats']['p95'], summary['teardown_wall_sec'],\n567:                     summary['ram_after_verify_mb']\n568:                 )\n569: \n570:         # Final cleanup sweep\n571:         max_m = max(teams) if teams else 15\n572:         await self.ensure_clean_environment(list(range(1, max_m + 1)))\n573: \n574:     # --------------------------------------------------------------------------\n575:     # CSV & Markdown Exporters\n576:     # --------------------------------------------------------------------------\n577:     def export_summary_csv(self, filename: str = CSV_SUMMARY_PATH):\n578:         Path(filename).parent.mkdir(parents=True, exist_ok=True)\n579:         headers = [\n580:             'test_name', 'test_type', 'teams_m', 'containers_per_team_n', 'cycles',\n581:             'live_containers', 'peak_verify_containers', 'passed_count', 'failed_count', 'pass_rate_pct',\n582:             # Sub-stage 1: Provisioning\n583:             'provision_wall_sec', 'provision_team_avg_sec', 'provision_team_p50_sec', 'provision_team_p95_sec',\n584:             'provision_team_min_sec', 'provision_team_max_sec', 'provision_team_std_sec',\n585:             # Sub-stage 2: Deployment Macro\n586:             'deploy_wall_sec', 'deploy_total_avg_sec', 'deploy_total_p50_sec', 'deploy_total_p95_sec',\n587:             'deploy_total_min_sec', 'deploy_total_max_sec', 'deploy_total_std_sec',\n588:             # Sub-stage 2: Deployment Micro-phases\n589:             'deploy_validation_avg_sec',\n590:             'deploy_create_avg_sec', 'deploy_create_p50_sec', 'deploy_create_p95_sec',\n591:             'deploy_push_avg_sec', 'deploy_push_p50_sec', 'deploy_push_p95_sec',\n592:             'deploy_start_avg_sec', 'deploy_start_p50_sec', 'deploy_start_p95_sec',\n593:             'deploy_runtime_net_avg_sec', 'deploy_runtime_net_p50_sec', 'deploy_runtime_net_p95_sec',\n594:             'deploy_db_record_avg_sec',\n595:             # Sub-stage 3: Verification Macro\n596:             'verify_wall_sec', 'verify_total_avg_sec', 'verify_total_p50_sec', 'verify_total_p95_sec',\n597:             'verify_total_min_sec', 'verify_total_max_sec', 'verify_total_std_sec',\n598:             # Sub-stage 3: Verification Micro-phases\n599:             'verify_setup_total_avg_sec', 'verify_setup_total_p50_sec', 'verify_setup_total_p95_sec',\n600:             'verify_ovn_create_avg_sec', 'verify_ovn_create_p50_sec', 'verify_ovn_create_p95_sec',\n601:             'verify_cow_clone_avg_sec', 'verify_cow_clone_p50_sec', 'verify_cow_clone_p95_sec',\n602:             'verify_clone_connect_avg_sec', 'verify_clone_connect_p50_sec', 'verify_clone_connect_p95_sec',\n603:             'verify_clone_start_avg_sec', 'verify_clone_start_p50_sec', 'verify_clone_start_p95_sec',\n604:             'verify_clone_runtime_net_avg_sec', 'verify_clone_runtime_net_p50_sec', 'verify_clone_runtime_net_p95_sec',\n605:             'verify_runner_avg_sec', 'verify_readiness_avg_sec',\n606:             'verify_cmds_avg_sec', 'verify_cmds_p50_sec', 'verify_cmds_p95_sec',\n607:             'verify_cleanup_clones_avg_sec', 'verify_cleanup_ovn_net_avg_sec',\n608:             'verify_cleanup_total_avg_sec', 'verify_cleanup_total_p50_sec', 'verify_cleanup_total_p95_sec',\n609:             # Sub-stage 4: Teardown\n610:             'teardown_machines_wall_sec', 'teardown_teams_wall_sec', 'teardown_wall_sec',\n611:             'teardown_machines_avg_sec', 'teardown_machines_p95_sec',\n612:             'teardown_team_avg_sec', 'teardown_team_p95_sec',\n613:             'teardown_total_avg_sec', 'teardown_total_p95_sec',\n614:             # Memory (MB)\n615:             'ram_baseline_mb', 'ram_after_deploy_mb', 'ram_after_verify_mb', 'ram_after_teardown_mb',\n616:         ]\n617:         with open(filename, 'w', newline='') as f:\n618:             writer = csv.writer(f)\n619:             writer.writerow(headers)\n620:             for r in self.results:\n621:                 ps = r.get('phase_stats', {})\n622:                 prov_s = r.get('provision_stats', {})\n623:                 dep_s = r.get('deploy_stats', {})\n624:                 ver_s = r.get('verify_stats', {})\n625:                 tm_s = r.get('teardown_machines_stats', {})\n626:                 tt_s = r.get('teardown_team_stats', {})\n627:                 ttot_s = r.get('teardown_total_stats', {})\n628: \n629:                 writer.writerow([\n630:                     r.get('test_name'),\n631:                     r.get('test_type'),\n632:                     r.get('teams_count'),\n633:                     r.get('containers_per_team'),\n634:                     r.get('cycles', 1),\n