f\"| {ps.get('deploy_push_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('deploy_start_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('deploy_runtime_net_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('ovn_create_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('cow_clone_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('clone_connect_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('clone_start_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('clone_runtime_net_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('verify_cmds_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('cleanup_sec', {}).get('avg', 0)} |\\n\"\n                )\n\n            # Section 3: Test 3 slice view (N=2 across M)\n            t3_rows = [r for r in self.results if r.get('containers_per_team') == 2]\n            if t3_rows:\n                f.write('\\n## 3. Test 3: Cross-Team Concurrency Burst Slice (N=2 Fixed)\\n\\n')\n                f.write('| Teams (M) | Live Cts | Peak Verify Cts | Pass | Deploy Wall (s) | Verify Wall (s) | Verify p50 (s) | Verify p95 (s) | OVN Create Avg (s) | CoW Clone Avg (s) |\\n')\n                f.write('| :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- |\\n')\n                for r in t3_rows:\n                    ps = r.get('phase_stats', {})\n                    f.write(\n                        f\"| {r.get('teams_count')} | {r.get('total_containers_live')} | {r.get('peak_containers_verify')} \"\n                        f\"| {r.get('passed_ratio')} | {r.get('deploy_wall_sec')} | {r.get('verify_wall_sec')} \"\n                        f\"| {r.get('verify_stats', {}).get('p50')} | {r.get('verify_stats', {}).get('p95')} \"\n                        f\"| {ps.get('ovn_create_sec', {}).get('avg', 0)} | {ps.get('cow_clone_sec', {}).get('avg', 0)} |\\n\"\n                    )\n\n        logger.info('[+] Exported Markdown Report to %s', filename)\n\n\nasync def main():\n    parser = argparse.ArgumentParser(description='BlueAgent Thesis Stress Benchmark Suite')\n    parser.add_argument('--test', choices=['1', 'matrix', 'all'], default='all',\n                        help='Which test to run: 1 (Baseline), matrix (Tiered Grid), or all')\n    parser.add_argument('--m', nargs='+', type=int, default=[2, 5, 10, 15], help='Teams M list')\n    parser.add_argument('--n', nargs='+', type=int, default=[2, 5, 7, 10], help='Containers N list')\n    parser.add_argument('--cycles', type=int, default=10, help='Cycles for Test 1')\n    parser.add_argument('--reset', action='store_true', help='Clear previous saved benchmark state before running')\n    args = parser.parse_args()\n\n    runner = BenchmarkRunner()\n    if not args.reset:\n        runner.load_existing_state()\n\n    ready = await runner.client.wait_server_ready(max_seconds=10.0)\n    if not ready:\n        logger.error('BlueAgent server is not responding on http://127.0.0.1:8000')\n        sys.exit(1)\n\n    t_suite_start = time.perf_counter()\n\n    if args.test in ('1', 'all'):\n        await runner.run_test_1(cycles=args.cycles)\n\n    if args.test in ('matrix', 'all'):\n        await runner.run_tiered_matrix(teams=args.m, containers=args.n)\n\n    total_elapsed = time.perf_counter() - t_suite_start\n    logger.info('[*] Stage Finished in %.2f seconds (%.2f minutes)', total_elapsed, total_elapsed / 60)\n\n\nif __name__ == '__main__':\n    asyncio.run(main())\n","Description":"Refactored benchmark_suite.py with full sub-stage and micro-phase CSV exports, incremental checkpointing, and parallel orphan cleanup","Overwrite":true,"TargetFile":"/home/davidel/.gemini/antigravity/brain/335ea41a-df46-4ffa-bb4c-eefc5a5248cd/scratch/benchmark_suite.py","toolAction":"Updating benchmark_suite.py with full sub-stage CSV exports","toolSummary":"Write updated benchmark_suite.py"}}]}
