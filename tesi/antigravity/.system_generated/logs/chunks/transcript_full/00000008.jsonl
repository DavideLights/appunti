{"step_index":424,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-16T18:45:38Z","input_tokens":3533,"cache_read_tokens":46115,"output_tokens":13378,"tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import argparse\nimport asyncio\nimport csv\nimport json\nimport logging\nimport math\nimport os\nimport sys\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nimport httpx\n\n# Ensure blueagent and tests are importable\nsys.path.insert(0, '/home/debian/bluectfd/blueagent/src')\nsys.path.insert(0, '/home/debian/bluectfd/blueagent')\nos.environ['BLUEAGENT_CTFD_API_TOKEN'] = 'secret-token'\n\nfrom blueagent.engine.incus import IncusEngine\nfrom tests.usability.client import BlueAgentTestClient\n\nlogging.basicConfig(\n    level=logging.INFO,\n    format='%(asctime)s [%(levelname)s] %(message)s',\n    datefmt='%H:%M:%S'\n)\nlogger = logging.getLogger('benchmark')\n\n\ndef percentile(data: List[float], p: float) -> float:\n    if not data:\n        return 0.0\n    sorted_data = sorted(data)\n    k = (len(sorted_data) - 1) * (p / 100.0)\n    f = math.floor(k)\n    c = math.ceil(k)\n    if f == c:\n        return round(sorted_data[int(k)], 4)\n    d0 = sorted_data[int(f)] * (c - k)\n    d1 = sorted_data[int(c)] * (k - f)\n    return round(d0 + d1, 4)\n\n\ndef calculate_stats(values: List[float]) -> Dict[str, float]:\n    if not values:\n        return {'avg': 0.0, 'p50': 0.0, 'p95': 0.0, 'min': 0.0, 'max': 0.0, 'std': 0.0}\n    avg = sum(values) / len(values)\n    variance = sum((x - avg) ** 2 for x in values) / len(values)\n    return {\n        'avg': round(avg, 4),\n        'p50': percentile(values, 50),\n        'p95': percentile(values, 95),\n        'min': round(min(values), 4),\n        'max': round(max(values), 4),\n        'std': round(math.sqrt(variance), 4),\n    }\n\n\ndef get_system_metrics() -> Dict[str, int]:\n    mem_total, mem_avail = 0, 0\n    try:\n        with open('/proc/meminfo', 'r') as f:\n            for line in f:\n                if line.startswith('MemTotal:'):\n                    mem_total = int(line.split()[1]) // 1024\n                elif line.startswith('MemAvailable:'):\n                    mem_avail = int(line.split()[1]) // 1024\n    except Exception:\n        pass\n    used_ram = mem_total - mem_avail\n    return {'used_ram_mb': used_ram, 'free_ram_mb': mem_avail}\n\n\ndef build_challenge_payload(\n    team_k: int,\n    num_containers: int,\n    image_alias: str = 'alpine',\n    memory_limit: str = '128MB'\n) -> Dict[str, Any]:\n    containers = []\n    verify_commands = []\n    for i in range(num_containers):\n        c_name = f'app{i+1}'\n        containers.append({\n            'name': c_name,\n            'image': image_alias,\n            'ip_suffix': i + 2,\n            'limits_cpu': '1',\n            'limits_memory': memory_limit\n        })\n        verify_commands.append({\n            'target': 'container',\n            'container_name': c_name,\n            'cmd': ['echo', f'verified_{c_name}'],\n            'timeout': 15,\n            'interval': 1,\n            'retry_timeout': 20\n        })\n\n    return {\n        'challenge_id': f'ch-bench-{team_k}',\n        'team_k': team_k,\n        'containers': containers,\n        'readiness_commands': [],\n        'verify_commands': verify_commands,\n        'verify_internet_access': False\n    }\n\n\nclass BenchmarkRunner:\n    def __init__(\n        self,\n        base_url: str = 'http://127.0.0.1:8000',\n        token: str = 'secret-token',\n        image_alias: str = 'alpine',\n        memory_limit: str = '128MB',\n        output_prefix: str = 'thesis_stress_test',\n    ):\n        self.client = BlueAgentTestClient(base_url=base_url, token=token, timeout=900.0)\n        self.image_alias = image_alias\n        self.memory_limit = memory_limit\n        self.output_prefix = output_prefix\n\n        base_dir = '/home/debian/bluectfd/blueagent/tests'\n        self.state_json_path = f'{base_dir}/{output_prefix}_state.json'\n        self.csv_summary_path = f'{base_dir}/{output_prefix}_results.csv'\n        self.csv_raw_samples_path = f'{base_dir}/{output_prefix}_raw_samples.csv'\n        self.report_output_path = f'{base_dir}/{output_prefix}_report.md'\n\n        self.results: List[Dict[str, Any]] = []\n        self.raw_samples: List[Dict[str, Any]] = []\n\n    def load_existing_state(self):\n        path = Path(self.state_json_path)\n        if path.exists():\n            try:\n                data = json.loads(path.read_text())\n                self.results = data.get('results', [])\n                self.raw_samples = data.get('raw_samples', [])\n                logger.info('Loaded %d existing tier results and %d raw samples from %s',\n                            len(self.results), len(self.raw_samples), self.state_json_path)\n            except Exception as e:\n                logger.warning('Could not load state file %s: %s', self.state_json_path, e)\n\n    def upsert_result(self, tier_res: Dict[str, Any], tier_samples: List[Dict[str, Any]]):\n        test_name = tier_res['test_name']\n        self.results = [r for r in self.results if r.get('test_name') != test_name]\n        self.results.append(tier_res)\n\n        self.raw_samples = [s for s in self.raw_samples if s.get('test_name') != test_name]\n        self.raw_samples.extend(tier_samples)\n\n        # Immediately flush all outputs so no progress is ever lost\n        self.save_state_json()\n        self.export_summary_csv()\n        self.export_raw_samples_csv()\n        self.export_markdown_report()\n\n    def save_state_json(self):\n        Path(self.state_json_path).parent.mkdir(parents=True, exist_ok=True)\n        with open(self.state_json_path, 'w') as f:\n            json.dump({'results': self.results, 'raw_samples': self.raw_samples}, f, indent=2)\n\n    async def ensure_clean_environment(self, team_ids: List[int]):\n        \"\"\"Parallel cleanup of BlueAgent teams + direct Incus sweep of any orphaned verify-* resources.\"\"\"\n        logger.info('Performing parallel pre-flight cleanup for teams: %s', team_ids)\n\n        async def _clean_team(k: int):\n            try:\n                await self.client.teardown_challenge(team_k=k)\n            except Exception:\n                pass\n            try:\n                await self.client.delete_team(team_k=k)\n            except Exception:\n                pass\n\n        await asyncio.gather(*[_clean_team(k) for k in team_ids])\n\n        # Sweep any orphaned verify-* containers or OVN networks directly via Incus UDS\n        engine = IncusEngine(socket_path='/var/lib/incus/unix.socket')\n        try:\n            instances = await engine.list_instances()\n            orphan_insts = [\n                name for name in instances\n                if name.startswith('verify-') or name.startswith('c-')\n            ]\n            if orphan_insts:\n                logger.warning('Sweeping %d orphaned Incus instances: %s', len(orphan_insts), orphan_insts)\n                await asyncio.gather(*[\n                    engine.delete_instance(name, force=True) for name in orphan_insts\n                ], return_exceptions=True)\n\n            networks = await engine.list_networks()\n            orphan_nets = [\n                name for name in networks\n                if name.startswith('verify-')\n            ]\n            if orphan_nets:\n                logger.warning('Sweeping %d orphaned OVN networks: %s', len(orphan_nets), orphan_nets)\n                await asyncio.gather(*[\n                    engine.delete_network(name) for name in orphan_nets\n                ], return_exceptions=True)\n        except Exception as e:\n            logger.warning('Incus orphan sweep warning: %s', e)\n        finally:\n            await engine.aclose()\n\n    async def _timed_create_team(self, k: int, name: str) -> Tuple[int, float, int]:\n        t0 = time.perf_counter()\n        r = await self.client.create_team(team_k=k, name=name)\n        return k, round(time.perf_counter() - t0, 4), r.status_code\n\n    async def _timed_deploy(self, k: int, payload: Dict[str, Any]) -> Tuple[int, float, httpx.Response]:\n        t0 = time.perf_counter()\n        r = await self.client.deploy_challenge(payload, team_k=k)\n        return k, round(time.perf_counter() - t0, 4), r\n\n    async def _timed_verify(self, k: int, payload: Dict[str, Any]) -> Tuple[int, float, httpx.Response]:\n        t0 = time.perf_counter()\n        r = await self.client.verify_challenge(team_k=k, config_payload=payload)\n        return k, round(time.perf_counter() - t0, 4), r\n\n    async def _timed_teardown_machines(self, k: int) -> Tuple[int, float, int]:\n        t0 = time.perf_counter()\n        r = await self.client.teardown_challenge(team_k=k)\n        return k, round(time.perf_counter() - t0, 4), r.status_code\n\n    async def _timed_delete_team(self, k: int) -> Tuple[int, float, int]:\n        t0 = time.perf_counter()\n        r = await self.client.delete_team(team_k=k)\n        return k, round(time.perf_counter() - t0, 4), r.status_code\n\n    # --------------------------------------------------------------------------\n    # Core Execution of a Single (M, N) Scenario or Cycle\n    # --------------------------------------------------------------------------\n    async def execute_barrier_scenario(\n        self,\n        test_name: str,\n        test_type: str,\n        m: int,\n        n: int,\n        cycle_idx: Optional[int] = None,\n        clean_before: bool = True,\n    ) -> Tuple[Dict[str, Any], List[Dict[str, Any]]]:\n        team_ids = list(range(1, m + 1))\n        if clean_before:\n            await self.ensure_clean_environment(team_ids)\n\n        ram_baseline = get_system_metrics()['used_ram_mb']\n\n        # SUB-STAGE 1: Provision M Teams in parallel & wait\n        t_prov_start = time.perf_counter()\n        prov_results = await asyncio.gather(*[\n            self._timed_create_team(k, f'{test_name} Team {k}')\n            for k in team_ids\n        ])\n        prov_wall_sec = round(time.perf_counter() - t_prov_start, 4)\n        prov_times_map = {k: elapsed for k, elapsed, _ in prov_results}\n\n        # SUB-STAGE 2: Deploy M x N Containers in parallel & wait\n        payloads = {\n            k: build_challenge_payload(\n                team_k=k,\n                num_containers=n,\n                image_alias=self.image_alias,\n                memory_limit=self.memory_limit,\n            ) for k in team_ids\n        }\n        t_dep_start = time.perf_counter()\n        dep_results = await asyncio.gather(*[\n            self._timed_deploy(k, payloads[k])\n            for k in team_ids\n        ])\n        dep_wall_sec = round(time.perf_counter() - t_dep_start, 4)\n        ram_after_deploy = get_system_metrics()['used_ram_mb']\n\n        # Short settle pause so ZFS/network state stabilizes before Verify burst\n        await asyncio.sleep(1.0)\n\n        # SUB-STAGE 3: Verify M Teams in parallel & wait\n        t_ver_start = time.perf_counter()\n        ver_results = await asyncio.gather(*[\n            self._timed_verify(k, payloads[k])\n            for k in team_ids\n        ])\n        ver_wall_sec = round(time.perf_counter() - t_ver_start, 4)\n        ram_after_verify = get_system_metrics()['used_ram_mb']\n\n        # SUB-STAGE 4: Teardown all M x N containers & M teams in parallel & wait\n        t_tear_start = time.perf_counter()\n        t_mach_start = time.perf_counter()\n        tear_mach_results = await asyncio.gather(*[\n            self._timed_teardown_machines(k)\n            for k in team_ids\n        ])\n        tear_machines_wall_sec = round(time.perf_counter() - t_mach_start, 4)\n\n        t_team_start = time.perf_counter()\n        tear_team_results = await asyncio.gather(*[\n            self._timed_delete_team(k)\n            for k in team_ids\n        ])\n        tear_teams_wall_sec = round(time.perf_counter() - t_team_start, 4)\n        teardown_wall_sec = round(time.perf_counter() - t_tear_start, 4)\n        ram_after_teardown = get_system_metrics()['used_ram_mb']\n\n        tear_mach_map = {k: elapsed for k, elapsed, _ in tear_mach_results}\n        tear_team_map = {k: elapsed for k, elapsed, _ in tear_team_results}\n\n        # Parse per-team metrics\n        dep_map = {k: (elapsed, r) for k, elapsed, r in dep_results}\n        ver_map = {k: (elapsed, r) for k, elapsed, r in ver_results}\n\n        raw_rows: List[Dict[str, Any]] = []\n        errors: List[str] = []\n        pass_count = 0\n\n        for k in team_ids:\n            prov_sec = prov_times_map[k]\n            dep_http_sec, r_dep = dep_map[k]\n            ver_http_sec, r_ver = ver_map[k]\n            tm_sec = tear_mach_map[k]\n            tt_sec = tear_team_map[k]\n\n            dep_st = {}\n            if r_dep.status_code in (200, 201):\n                dep_st = r_dep.json().get('step_timings', {})\n            else:\n                errors.append(f'Team {k} Deploy HTTP {r_dep.status_code}: {r_dep.text[:120]}')\n\n            ver_st = {}\n            sb = {}\n            cl = {}\n            ver_passed = False\n            if r_ver.status_code == 200:\n                v_json = r_ver.json()\n                ver_passed = bool(v_json.get('passed'))\n                if ver_passed:\n                    pass_count += 1\n                ver_st = v_json.get('details', {}).get('step_timings', {})\n                sb = ver_st.get('sandbox_setup', {})\n                cl = ver_st.get('cleanup', {})\n            else:\n                errors.append(f'Team {k} Verify HTTP {r_ver.status_code}: {r_ver.text[:150]}')\n                logger.error('[%s] Team %d verify error: %s', test_name, k, r_ver.text[:200])\n\n            row = {\n                'test_name': test_name,\n                'image_alias': self.image_alias,\n                'test_type': test_type,\n                'teams_m': m,\n                'containers_n': n,\n                'cycle': cycle_idx if cycle_idx is not None else 1,\n                'team_k': k,\n                'http_deploy_status': r_dep.status_code,\n                'http_verify_status': r_ver.status_code,\n                'verify_passed': int(ver_passed),\n                # Sub-stage 1: Provision\n                'provision_team_sec': prov_sec,\n                # Sub-stage 2: Deploy\n                'deploy_http_sec': dep_http_sec,\n                'deploy_total_sec': dep_st.get('total_deploy_sec', dep_http_sec),\n                'deploy_validation_sec': dep_st.get('validation_sec', 0.0),\n                'deploy_create_sec': dep_st.get('total_create_sec', 0.0),\n                'deploy_push_sec': dep_st.get('total_push_sec', 0.0),\n                'deploy_start_sec': dep_st.get('total_start_sec', 0.0),\n                'deploy_runtime_net_sec': dep_st.get('total_runtime_net_sec', 0.0),\n                'deploy_db_record_sec': dep_st.get('total_db_record_sec', 0.0),\n                # Sub-stage 3: Verify\n                'verify_http_sec': ver_http_sec,\n                'verify_total_sec': ver_st.get('total_verify_lifecycle_sec', ver_http_sec if r_ver.status_code == 200 else 0.0),\n                'verify_setup_total_sec': sb.get('total_setup_sec', 0.0),\n                'verify_ovn_net_create_sec': sb.get('ovn_network_create_sec', 0.0),\n                'verify_cow_clone_sec': sb.get('total_clone_time_sec', 0.0),\n                'verify_clone_connect_sec': sb.get('total_connect_time_sec', 0.0),\n                'verify_clone_start_sec': sb.get('total_start_time_sec', 0.0),\n                'verify_clone_runtime_net_sec': sb.get('total_runtime_net_sec', 0.0),\n                'verify_runner_sec': sb.get('verifier_runner_sec', 0.0),\n                'verify_readiness_sec': ver_st.get('readiness_sec', 0.0),\n                'verify_commands_sec': ver_st.get('verify_commands_sec', 0.0),\n                'verify_cleanup_clones_sec': cl.get('clones_teardown_sec', 0.0),\n                'verify_cleanup_ovn_net_sec': cl.get('ovn_network_delete_sec', 0.0),\n                'verify_cleanup_total_sec': cl.get('total_cleanup_sec', 0.0),\n                # Sub-stage 4: Teardown\n                'teardown_machines_sec': tm_sec,\n                'teardown_team_sec': tt_sec,\n                'teardown_total_sec': round(tm_sec + tt_sec, 4),\n            }\n            raw_rows.append(row)\n\n        summary = self._aggregate_rows_to_summary(\n            test_name=test_name,\n            test_type=test_type,\n            m=m,\n            n=n,\n            cycles=1,\n            raw_rows=raw_rows,\n            prov_wall_sec=prov_wall_sec,\n            dep_wall_sec=dep_wall_sec,\n            ver_wall_sec=ver_wall_sec,\n            tear_machines_wall_sec=tear_machines_wall_sec,\n            tear_teams_wall_sec=tear_teams_wall_sec,\n            teardown_wall_sec=teardown_wall_sec,\n            ram_baseline=ram_baseline,\n            ram_after_deploy=ram_after_deploy,\n            ram_after_verify=ram_after_verify,\n            ram_after_teardown=ram_after_teardown,\n            errors=errors,\n        )\n        return summary, raw_rows\n\n    def _aggregate_rows_to_summary(\n        self,\n        test_name: str,\n        test_type: str,\n        m: int,\n        n: int,\n        cycles: int,\n        raw_rows: List[Dict[str, Any]],\n        prov_wall_sec: float,\n        dep_wall_sec: float,\n        ver_wall_sec: float,\n        tear_machines_wall_sec: float,\n        tear_teams_wall_sec: float,\n        teardown_wall_sec: float,\n        ram_baseline: int,\n        ram_after_deploy: int,\n        ram_after_verify: int,\n        ram_after_teardown: int,\n        errors: List[str],\n    ) -> Dict[str, Any]:\n        ok_dep = [r for r in raw_rows if r['http_deploy_status'] in (200, 201)]\n        ok_ver = [r for r in raw_rows if r['http_verify_status'] == 200 and r['verify_passed'] == 1]\n        total_attempts = len(raw_rows)\n        passed_count = len(ok_ver)\n        failed_count = total_attempts - passed_count\n\n        def col_stats(rows: List[Dict[str, Any]], key: str) -> Dict[str, float]:\n            return calculate_stats([float(r[key]) for r in rows])\n\n        return {\n            'test_name': test_name,\n            'image_alias': self.image_alias,\n            'test_type': test_type,\n            'teams_count': m,\n            'containers_per_team': n,\n            'cycles': cycles,\n            'total_containers_live': m * n,\n            'peak_containers_verify': 2 * m * n,\n            'passed_count': passed_count,\n            'failed_count': failed_count,\n            'passed_ratio': f'{passed_count}/{total_attempts}',\n            'pass_rate_pct': round((passed_count / total_attempts) * 100.0, 2) if total_attempts else 0.0,\n            # Wall-clock times per barrier sub-stage\n            'provision_wall_sec': prov_wall_sec,\n            'deploy_wall_sec': dep_wall_sec,\n            'verify_wall_sec': ver_wall_sec,\n            'teardown_machines_wall_sec': tear_machines_wall_sec,\n            'teardown_teams_wall_sec': tear_teams_wall_sec,\n            'teardown_wall_sec': teardown_wall_sec,\n            # Macro stats\n            'provision_stats': col_stats(raw_rows, 'provision_team_sec'),\n            'deploy_stats': col_stats(ok_dep, 'deploy_total_sec'),\n            'verify_stats': col_stats(ok_ver, 'verify_total_sec'),\n            'teardown_machines_stats': col_stats(raw_rows, 'teardown_machines_sec'),\n            'teardown_team_stats': col_stats(raw_rows, 'teardown_team_sec'),\n            'teardown_total_stats': col_stats(raw_rows, 'teardown_total_sec'),\n            # Micro-phase stats\n            'phase_stats': {\n                # Deploy micro-phases\n                'deploy_validation_sec': col_stats(ok_dep, 'deploy_validation_sec'),\n                'deploy_create_sec': col_stats(ok_dep, 'deploy_create_sec'),\n                'deploy_push_sec': col_stats(ok_dep, 'deploy_push_sec'),\n                'deploy_start_sec': col_stats(ok_dep, 'deploy_start_sec'),\n                'deploy_runtime_net_sec': col_stats(ok_dep, 'deploy_runtime_net_sec'),\n                'deploy_db_record_sec': col_stats(ok_dep, 'deploy_db_record_sec'),\n                # Verify micro-phases\n                'verify_setup_total_sec': col_stats(ok_ver, 'verify_setup_total_sec'),\n                'ovn_create_sec': col_stats(ok_ver, 'verify_ovn_net_create_sec'),\n                'cow_clone_sec': col_stats(ok_ver, 'verify_cow_clone_sec'),\n                'clone_connect_sec': col_stats(ok_ver, 'verify_clone_connect_sec'),\n                'clone_start_sec': col_stats(ok_ver, 'verify_clone_start_sec'),\n                'clone_runtime_net_sec': col_stats(ok_ver, 'verify_clone_runtime_net_sec'),\n                'verify_runner_sec': col_stats(ok_ver, 'verify_runner_sec'),\n                'verify_readiness_sec': col_stats(ok_ver, 'verify_readiness_sec'),\n                'verify_cmds_sec': col_stats(ok_ver, 'verify_commands_sec'),\n                'cleanup_clones_sec': col_stats(ok_ver, 'verify_cleanup_clones_sec'),\n                'cleanup_ovn_net_sec': col_stats(ok_ver, 'verify_cleanup_ovn_net_sec'),\n                'cleanup_sec': col_stats(ok_ver, 'verify_cleanup_total_sec'),\n            },\n            # Memory snapshots across barriers\n            'ram_baseline_mb': ram_baseline,\n            'ram_after_deploy_mb': ram_after_deploy,\n            'ram_after_verify_mb': ram_after_verify,\n            'ram_after_teardown_mb': ram_after_teardown,\n            'ram_used_mb': ram_after_verify,\n            'errors': errors,\n        }\n\n    # --------------------------------------------------------------------------\n    # TEST 1: Single-Team Baseline & Micro-Phase Profiling\n    # --------------------------------------------------------------------------\n    async def run_test_1(self, cycles: int = 10):\n        logger.info('===============================================================')\n        logger.info('TEST 1: SINGLE-TEAM BASELINE (Image=%s, M=1, N=1, %d cycles)', self.image_alias, cycles)\n        logger.info('===============================================================')\n\n        await self.ensure_clean_environment([1])\n        all_cycle_rows: List[Dict[str, Any]] = []\n        all_errors: List[str] = []\n        prov_walls, dep_walls, ver_walls, tm_walls, tt_walls, tear_walls = [], [], [], [], [], []\n        ram_base_list, ram_dep_list, ram_ver_list, ram_tear_list = [], [], [], []\n\n        for c in range(1, cycles + 1):\n            logger.info('[Test 1] Cycle %d/%d starting...', c, cycles)\n            summary_c, rows_c = await self.execute_barrier_scenario(\n                test_name=f'Test 1 Baseline ({self.image_alias})',\n                test_type='test_1_baseline',\n                m=1,\n                n=1,\n                cycle_idx=c,\n                clean_before=False,\n            )\n            all_cycle_rows.extend(rows_c)\n            all_errors.extend(summary_c['errors'])\n            prov_walls.append(summary_c['provision_wall_sec'])\n            dep_walls.append(summary_c['deploy_wall_sec'])\n            ver_walls.append(summary_c['verify_wall_sec'])\n            tm_walls.append(summary_c['teardown_machines_wall_sec'])\n            tt_walls.append(summary_c['teardown_teams_wall_sec'])\n            tear_walls.append(summary_c['teardown_wall_sec'])\n            ram_base_list.append(summary_c['ram_baseline_mb'])\n            ram_dep_list.append(summary_c['ram_after_deploy_mb'])\n            ram_ver_list.append(summary_c['ram_after_verify_mb'])\n            ram_tear_list.append(summary_c['ram_after_teardown_mb'])\n            logger.info('[Test 1] Cycle %d/%d finished: Prov=%.3fs, Deploy=%.3fs, Verify=%.3fs, Teardown=%.3fs',\n                        c, cycles, summary_c['provision_wall_sec'], summary_c['deploy_wall_sec'],\n                        summary_c['verify_wall_sec'], summary_c['teardown_wall_sec'])\n\n        final_summary = self._aggregate_rows_to_summary(\n            test_name=f'Test 1 Baseline ({self.image_alias})',\n            test_type='test_1_baseline',\n            m=1,\n            n=1,\n            cycles=cycles,\n            raw_rows=all_cycle_rows,\n            prov_wall_sec=round(sum(prov_walls) / len(prov_walls), 4),\n            dep_wall_sec=round(sum(dep_walls) / len(dep_walls), 4),\n            ver_wall_sec=round(sum(ver_walls) / len(ver_walls), 4),\n            tear_machines_wall_sec=round(sum(tm_walls) / len(tm_walls), 4),\n            tear_teams_wall_sec=round(sum(tt_walls) / len(tt_walls), 4),\n            teardown_wall_sec=round(sum(tear_walls) / len(tear_walls), 4),\n            ram_baseline=int(sum(ram_base_list) / len(ram_base_list)),\n            ram_after_deploy=int(sum(ram_dep_list) / len(ram_dep_list)),\n            ram_after_verify=int(sum(ram_ver_list) / len(ram_ver_list)),\n            ram_after_teardown=int(sum(ram_tear_list) / len(ram_tear_list)),\n            errors=all_errors,\n        )\n        self.upsert_result(final_summary, all_cycle_rows)\n        logger.info('[+] Test 1 Completed and flushed to CSV/Markdown.')\n        return final_summary\n\n    # --------------------------------------------------------------------------\n    # TIERED STRESS TEST MATRIX\n    # --------------------------------------------------------------------------\n    async def run_tiered_matrix(self, teams: List[int], containers: List[int]):\n        logger.info('===============================================================')\n        logger.info('TIERED STRESS TEST MATRIX (Image=%s, M in %s, N in %s)', self.image_alias, teams, containers)\n        logger.info('===============================================================')\n\n        for m in teams:\n            for n in containers:\n                test_name = f'Tier M={m} N={n}'\n                logger.info('>>> STARTING TIER: M=%d teams, N=%d containers/team (Peak Instances: %d) <<<',\n                            m, n, 2 * m * n)\n                summary, raw_rows = await self.execute_barrier_scenario(\n                    test_name=test_name,\n                    test_type='matrix_and_test3' if n == 2 else 'matrix',\n                    m=m,\n                    n=n,\n                    cycle_idx=1,\n                    clean_before=True,\n                )\n                self.upsert_result(summary, raw_rows)\n                logger.info(\n                    '[+] Completed %s (Pass=%s): ProvWall=%.3fs, DeployWall=%.3fs, VerifyWall=%.3fs (p95=%.3fs), TeardownWall=%.3fs, RAM=%dMB',\n                    test_name, summary['passed_ratio'], summary['provision_wall_sec'],\n                    summary['deploy_wall_sec'], summary['verify_wall_sec'],\n                    summary['verify_stats']['p95'], summary['teardown_wall_sec'],\n                    summary['ram_after_verify_mb']\n                )\n\n        # Final cleanup sweep\n        max_m = max(teams) if teams else 15\n        await self.ensure_clean_environment(list(range(1, max_m + 1)))\n\n    # --------------------------------------------------------------------------\n    # CSV & Markdown Exporters\n    # --------------------------------------------------------------------------\n    def export_summary_csv(self):\n        filename = self.csv_summary_path\n        Path(filename).parent.mkdir(parents=True, exist_ok=True)\n        headers = [\n            'test_name', 'image_alias', 'test_type', 'teams_m', 'containers_per_team_n', 'cycles',\n            'live_containers', 'peak_verify_containers', 'passed_count', 'failed_count', 'pass_rate_pct',\n            # Sub-stage 1: Provisioning\n            'provision_wall_sec', 'provision_team_avg_sec', 'provision_team_p50_sec', 'provision_team_p95_sec',\n            'provision_team_min_sec', 'provision_team_max_sec', 'provision_team_std_sec',\n            # Sub-stage 2: Deployment Macro\n            'deploy_wall_sec', 'deploy_total_avg_sec', 'deploy_total_p50_sec', 'deploy_total_p95_sec',\n            'deploy_total_min_sec', 'deploy_total_max_sec', 'deploy_total_std_sec',\n            # Sub-stage 2: Deployment Micro-phases\n            'deploy_validation_avg_sec',\n            'deploy_create_avg_sec', 'deploy_create_p50_sec', 'deploy_create_p95_sec',\n            'deploy_push_avg_sec', 'deploy_push_p50_sec', 'deploy_push_p95_sec',\n            'deploy_start_avg_sec', 'deploy_start_p50_sec', 'deploy_start_p95_sec',\n            'deploy_runtime_net_avg_sec', 'deploy_runtime_net_p50_sec', 'deploy_runtime_net_p95_sec',\n            'deploy_db_record_avg_sec',\n            # Sub-stage 3: Verification Macro\n            'verify_wall_sec', 'verify_total_avg_sec', 'verify_total_p50_sec', 'verify_total_p95_sec',\n            'verify_total_min_sec', 'verify_total_max_sec', 'verify_total_std_sec',\n            # Sub-stage 3: Verification Micro-phases\n            'verify_setup_total_avg_sec', 'verify_setup_total_p50_sec', 'verify_setup_total_p95_sec',\n            'verify_ovn_create_avg_sec', 'verify_ovn_create_p50_sec', 'verify_ovn_create_p95_sec',\n            'verify_cow_clone_avg_sec', 'verify_cow_clone_p50_sec', 'verify_cow_clone_p95_sec',\n            'verify_clone_connect_avg_sec', 'verify_clone_connect_p50_sec', 'verify_clone_connect_p95_sec',\n            'verify_clone_start_avg_sec', 'verify_clone_start_p50_sec', 'verify_clone_start_p95_sec',\n            'verify_clone_runtime_net_avg_sec', 'verify_clone_runtime_net_p50_sec', 'verify_clone_runtime_net_p95_sec',\n            'verify_runner_avg_sec', 'verify_readiness_avg_sec',\n            'verify_cmds_avg_sec', 'verify_cmds_p50_sec', 'verify_cmds_p95_sec',\n            'verify_cleanup_clones_avg_sec', 'verify_cleanup_ovn_net_avg_sec',\n            'verify_cleanup_total_avg_sec', 'verify_cleanup_total_p50_sec', 'verify_cleanup_total_p95_sec',\n            # Sub-stage 4: Teardown\n            'teardown_machines_wall_sec', 'teardown_teams_wall_sec', 'teardown_wall_sec',\n            'teardown_machines_avg_sec', 'teardown_machines_p95_sec',\n            'teardown_team_avg_sec', 'teardown_team_p95_sec',\n            'teardown_total_avg_sec', 'teardown_total_p95_sec',\n            # Memory (MB)\n            'ram_baseline_mb', 'ram_after_deploy_mb', 'ram_after_verify_mb', 'ram_after_teardown_mb',\n        ]\n        with open(filename, 'w', newline='') as f:\n            writer = csv.writer(f)\n            writer.writerow(headers)\n            for r in self.results:\n                ps = r.get('phase_stats', {})\n                prov_s = r.get('provision_stats', {})\n                dep_s = r.get('deploy_stats', {})\n                ver_s = r.get('verify_stats', {})\n                tm_s = r.get('teardown_machines_stats', {})\n                tt_s = r.get('teardown_team_stats', {})\n                ttot_s = r.get('teardown_total_stats', {})\n\n                writer.writerow([\n                    r.get('test_name'),\n                    r.get('image_alias', self.image_alias),\n                    r.get('test_type'),\n                    r.get('teams_count'),\n                    r.get('containers_per_team'),\n                    r.get('cycles', 1),\n                    r.get('total_containers_live'),\n                    r.get('peak_containers_verify'),\n                    r.get('passed_count'),\n                    r.get('failed_count'),\n                    r.get('pass_rate_pct'),\n                    # Sub-stage 1\n                    r.get('provision_wall_sec'),\n                    prov_s.get('avg', 0), prov_s.get('p50', 0), prov_s.get('p95', 0),\n                    prov_s.get('min', 0), prov_s.get('max', 0), prov_s.get('std', 0),\n                    # Sub-stage 2 Macro\n                    r.get('deploy_wall_sec'),\n                    dep_s.get('avg', 0), dep_s.get('p50', 0), dep_s.get('p95', 0),\n                    dep_s.get('min', 0), dep_s.get('max', 0), dep_s.get('std', 0),\n                    # Sub-stage 2 Micro\n                    ps.get('deploy_validation_sec', {}).get('avg', 0),\n                    ps.get('deploy_create_sec', {}).get('avg', 0),\n                    ps.get('deploy_create_sec', {}).get('p50', 0),\n                    ps.get('deploy_create_sec', {}).get('p95', 0),\n                    ps.get('deploy_push_sec', {}).get('avg', 0),\n                    ps.get('deploy_push_sec', {}).get('p50', 0),\n                    ps.get('deploy_push_sec', {}).get('p95', 0),\n                    ps.get('deploy_start_sec', {}).get('avg', 0),\n                    ps.get('deploy_start_sec', {}).get('p50', 0),\n                    ps.get('deploy_start_sec', {}).get('p95', 0),\n                    ps.get('deploy_runtime_net_sec', {}).get('avg', 0),\n                    ps.get('deploy_runtime_net_sec', {}).get('p50', 0),\n                    ps.get('deploy_runtime_net_sec', {}).get('p95', 0),\n                    ps.get('deploy_db_record_sec', {}).get('avg', 0),\n                    # Sub-stage 3 Macro\n                    r.get('verify_wall_sec'),\n                    ver_s.get('avg', 0), ver_s.get('p50', 0), ver_s.get('p95', 0),\n                    ver_s.get('min', 0), ver_s.get('max', 0), ver_s.get('std', 0),\n                    # Sub-stage 3 Micro\n                    ps.get('verify_setup_total_sec', {}).get('avg', 0),\n                    ps.get('verify_setup_total_sec', {}).get('p50', 0),\n                    ps.get('verify_setup_total_sec', {}).get('p95', 0),\n                    ps.get('ovn_create_sec', {}).get('avg', 0),\n                    ps.get('ovn_create_sec', {}).get('p50', 0),\n                    ps.get('ovn_create_sec', {}).get('p95', 0),\n                    ps.get('cow_clone_sec', {}).get('avg', 0),\n                    ps.get('cow_clone_sec', {}).get('p50', 0),\n                    ps.get('cow_clone_sec', {}).get('p95', 0),\n                    ps.get('clone_connect_sec', {}).get('avg', 0),\n                    ps.get('clone_connect_sec', {}).get('p50', 0),\n                    ps.get('clone_connect_sec', {}).get('p95', 0),\n                    ps.get('clone_start_sec', {}).get('avg', 0),\n                    ps.get('clone_start_sec', {}).get('p50', 0),\n                    ps.get('clone_start_sec', {}).get('p95', 0),\n                    ps.get('clone_runtime_net_sec', {}).get('avg', 0),\n                    ps.get('clone_runtime_net_sec', {}).get('p50', 0),\n                    ps.get('clone_runtime_net_sec', {}).get('p95', 0),\n                    ps.get('verify_runner_sec', {}).get('avg', 0),\n                    ps.get('verify_readiness_sec', {}).get('avg', 0),\n                    ps.get('verify_cmds_sec', {}).get('avg', 0),\n                    ps.get('verify_cmds_sec', {}).get('p50', 0),\n                    ps.get('verify_cmds_sec', {}).get('p95', 0),\n                    ps.get('cleanup_clones_sec', {}).get('avg', 0),\n                    ps.get('cleanup_ovn_net_sec', {}).get('avg', 0),\n                    ps.get('cleanup_sec', {}).get('avg', 0),\n                    ps.get('cleanup_sec', {}).get('p50', 0),\n                    ps.get('cleanup_sec', {}).get('p95', 0),\n                    # Sub-stage 4 Teardown\n                    r.get('teardown_machines_wall_sec'),\n                    r.get('teardown_teams_wall_sec'),\n                    r.get('teardown_wall_sec'),\n                    tm_s.get('avg', 0), tm_s.get('p95', 0),\n                    tt_s.get('avg', 0), tt_s.get('p95', 0),\n                    ttot_s.get('avg', 0), ttot_s.get('p95', 0),\n                    # RAM\n                    r.get('ram_baseline_mb', 0),\n                    r.get('ram_after_deploy_mb', 0),\n                    r.get('ram_after_verify_mb', 0),\n                    r.get('ram_after_teardown_mb', 0),\n                ])\n        logger.info('[+] Exported Summary CSV (%d rows) to %s', len(self.results), filename)\n\n    def export_raw_samples_csv(self):\n        filename = self.csv_raw_samples_path\n        Path(filename).parent.mkdir(parents=True, exist_ok=True)\n        if not self.raw_samples:\n            return\n        headers = list(self.raw_samples[0].keys())\n        with open(filename, 'w', newline='') as f:\n            writer = csv.DictWriter(f, fieldnames=headers)\n            writer.writeheader()\n            writer.writerows(self.raw_samples)\n        logger.info('[+] Exported Raw Samples CSV (%d rows) to %s', len(self.raw_samples), filename)\n\n    def export_markdown_report(self):\n        filename = self.report_output_path\n        Path(filename).parent.mkdir(parents=True, exist_ok=True)\n        now_str = datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S UTC')\n        with open(filename, 'w') as f:\n            f.write(f'# BlueAgent Stress & Scalability Benchmark Report ({self.image_alias})\\n\\n')\n            f.write(f'*Generated on:* `{now_str}` on AMD Ryzen 7 7700X (8 Cores), 15 GiB RAM\\n')\n            f.write(f'*Image Alias:* `{self.image_alias}` | *Memory Limit:* `{self.memory_limit}`\\n\\n')\n\n            f.write('## 1. Macro Sub-Stage Timings (Provision, Deploy, Verify, Teardown)\\n\\n')\n            f.write('| Scenario | M | N | Peak Cts | Pass | Prov Wall (s) | Deploy Wall (s) | Deploy p95 (s) | Verify Wall (s) | Verify p95 (s) | Teardown Wall (s) | RAM Verify (MB) |\\n')\n            f.write('| :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- |\\n')\n            for r in self.results:\n                f.write(\n                    f\"| {r.get('test_name')} | {r.get('teams_count')} | {r.get('containers_per_team')} \"\n                    f\"| {r.get('peak_containers_verify')} | {r.get('passed_ratio')} \"\n                    f\"| {r.get('provision_wall_sec')} | {r.get('deploy_wall_sec')} | {r.get('deploy_stats', {}).get('p95')} \"\n                    f\"| {r.get('verify_wall_sec')} | {r.get('verify_stats', {}).get('p95')} \"\n                    f\"| {r.get('teardown_wall_sec')} | {r.get('ram_after_verify_mb')} |\\n\"\n                )\n\n            f.write('\\n## 2. Micro-Phase Breakdown (Averages per Team in Seconds)\\n\\n')\n            f.write('| Scenario | Dep Create | Dep Push | Dep Start | Dep Net | OVN Create | CoW Clone | Clone Connect | Clone Start | Clone Net | Verify Cmds | Cleanup |\\n')\n            f.write('| :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- |\\n')\n            for r in self.results:\n                ps = r.get('phase_stats', {})\n                f.write(\n                    f\"| {r.get('test_name')} \"\n                    f\"| {ps.get('deploy_create_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('deploy_push_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('deploy_start_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('deploy_runtime_net_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('ovn_create_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('cow_clone_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('clone_connect_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('clone_start_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('clone_runtime_net_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('verify_cmds_sec', {}).get('avg', 0)} \"\n                    f\"| {ps.get('cleanup_sec', {}).get('avg', 0)} |\\n\"\n                )\n\n            # Section 3: Test 3 slice view (N=2 across M)\n            t3_rows = [r for r in self.results if r.get('containers_per_team') == 2]\n            if t3_rows:\n                f.write('\\n## 3. Test 3: Cross-Team Concurrency Burst Slice (N=2 Fixed)\\n\\n')\n                f.write('| Teams (M) | Live Cts | Peak Verify Cts | Pass | Deploy Wall (s) | Verify Wall (s) | Verify p50 (s) | Verify p95 (s) | OVN Create Avg (s) | CoW Clone Avg (s) |\\n')\n                f.write('| :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- |\\n')\n                for r in t3_rows:\n                    ps = r.get('phase_stats', {})\n                    f.write(\n                        f\"| {r.get('teams_count')} | {r.get('total_containers_live')} | {r.get('peak_containers_verify')} \"\n                        f\"| {r.get('passed_ratio')} | {r.get('deploy_wall_sec')} | {r.get('verify_wall_sec')} \"\n                        f\"| {r.get('verify_stats', {}).get('p50')} | {r.get('verify_stats', {}).get('p95')} \"\n                        f\"| {ps.get('ovn_create_sec', {}).get('avg', 0)} | {ps.get('cow_clone_sec', {}).get('avg', 0)} |\\n\"\n                    )\n\n        logger.info('[+] Exported Markdown Report to %s', filename)\n\n\nasync def main():\n    parser = argparse.ArgumentParser(description='BlueAgent Thesis Stress Benchmark Suite')\n    parser.add_argument('--image', type=str, default='alpine', help='Container image alias (e.g. alpine, ubuntu-heavy)')\n    parser.add_argument('--memory-limit', type=str, default='128MB', help='Memory limit per container (e.g. 128MB, 256MB)')\n    parser.add_argument('--output-prefix', type=str, default='thesis_stress_test', help='Prefix for output files (CSV, JSON, MD)')\n    parser.add_argument('--test', choices=['1', 'matrix', 'all'], default='all',\n                        help='Which test to run: 1 (Baseline), matrix (Tiered Grid), or all')\n    parser.add_argument('--m', nargs='+', type=int, default=[2, 5, 10, 15], help='Teams M list')\n    parser.add_argument('--n', nargs='+', type=int, default=[2, 5, 7, 10], help='Containers N list')\n    parser.add_argument('--cycles', type=int, default=10, help='Cycles for Test 1')\n    parser.add_argument('--reset', action='store_true', help='Clear previous saved benchmark state before running')\n    args = parser.parse_args()\n\n    runner = BenchmarkRunner(\n        image_alias=args.image,\n        memory_limit=args.memory_limit,\n        output_prefix=args.output_prefix,\n    )\n    if not args.reset:\n        runner.load_existing_state()\n\n    ready = await runner.client.wait_server_ready(max_seconds=10.0)\n    if not ready:\n        logger.error('BlueAgent server is not responding on http://127.0.0.1:8000')\n        sys.exit(1)\n\n    t_suite_start = time.perf_counter()\n\n    if args.test in ('1', 'all'):\n        await runner.run_test_1(cycles=args.cycles)\n\n    if args.test in ('matrix', 'all'):\n        await runner.run_tiered_matrix(teams=args.m, containers=args.n)\n\n    total_elapsed = time.perf_counter() - t_suite_start\n    logger.info('[*] Stage Finished in %.2f seconds (%.2f minutes)', total_elapsed, total_elapsed / 60)\n\n\nif __name__ == '__main__':\n    asyncio.run(main())\n","Description":"Update benchmark_suite.py with multi-image support, custom output prefix, memory limits, and image_alias column","Overwrite":true,"TargetFile":"/home/davidel/.gemini/antigravity/brain/335ea41a-df46-4ffa-bb4c-eefc5a5248cd/scratch/benchmark_suite.py","toolAction":"Writing updated benchmark_suite.py","toolSummary":"Update benchmark_suite.py with multi-image support"}}]}
