{"step_index":231,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-16T17:22:51Z","input_tokens":2845,"cache_read_tokens":112689,"output_tokens":7504,"thinking":"Building the benchmark suite, starting with a single-team baseline to establish initial latency values and standard deviations for internal phases using 10 cycles. This baseline will inform subsequent cross-team concurrency tests, which will test concurrent verification requests across multiple teams (2, 5, 10, 15 teams). The multi-team tests will isolate and measure lock contention, OVN creation latency, and Incus UDS performance under increasing load.\n\n\n","tool_calls":[{"name":"run_command","args":{"CommandLine":"ssh debian@192.168.0.199 \"cat << 'EOF' > /home/debian/bluectfd/blueagent/benchmark_suite.py\nimport argparse\nimport asyncio\nimport csv\nimport json\nimport logging\nimport math\nimport os\nimport sys\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional\n\n# Ensure blueagent and tests are importable\nsys.path.insert(0, '/home/debian/bluectfd/blueagent/src')\nsys.path.insert(0, '/home/debian/bluectfd/blueagent')\nos.environ['BLUEAGENT_CTFD_API_TOKEN'] = 'secret-token'\n\nfrom tests.usability.client import BlueAgentTestClient\n\nlogging.basicConfig(\n    level=logging.INFO,\n    format='%(asctime)s [%(levelname)s] %(message)s',\n    datefmt='%H:%M:%S'\n)\nlogger = logging.getLogger('benchmark')\n\nCSV_OUTPUT_PATH = '/home/debian/bluectfd/blueagent/tests/thesis_stress_test_results.csv'\nREPORT_OUTPUT_PATH = '/home/debian/bluectfd/blueagent/tests/thesis_stress_test_report.md'\n\ndef percentile(data: List[float], p: float) -> float:\n    if not data:\n        return 0.0\n    sorted_data = sorted(data)\n    k = (len(sorted_data) - 1) * (p / 100.0)\n    f = math.floor(k)\n    c = math.ceil(k)\n    if f == c:\n        return round(sorted_data[int(k)], 4)\n    d0 = sorted_data[int(f)] * (c - k)\n    d1 = sorted_data[int(c)] * (k - f)\n    return round(d0 + d1, 4)\n\ndef calculate_stats(values: List[float]) -> Dict[str, float]:\n    if not values:\n        return {'avg': 0.0, 'p50': 0.0, 'p95': 0.0, 'min': 0.0, 'max': 0.0, 'std': 0.0}\n    avg = sum(values) / len(values)\n    variance = sum((x - avg) ** 2 for x in values) / len(values)\n    return {\n        'avg': round(avg, 4),\n        'p50': percentile(values, 50),\n        'p95': percentile(values, 95),\n        'min': round(min(values), 4),\n        'max': round(max(values), 4),\n        'std': round(math.sqrt(variance), 4),\n    }\n\ndef get_system_metrics() -> Dict[str, float]:\n    mem_total, mem_avail = 0, 0\n    try:\n        with open('/proc/meminfo', 'r') as f:\n            for line in f:\n                if line.startswith('MemTotal:'):\n                    mem_total = int(line.split()[1]) // 1024\n                elif line.startswith('MemAvailable:'):\n                    mem_avail = int(line.split()[1]) // 1024\n    except Exception:\n        pass\n    used_ram = mem_total - mem_avail\n    return {'used_ram_mb': used_ram, 'free_ram_mb': mem_avail}\n\ndef build_challenge_payload(team_k: int, num_containers: int) -> Dict[str, Any]:\n    containers = []\n    verify_commands = []\n    for i in range(num_containers):\n        c_name = f'app{i+1}'\n        containers.append({\n            'name': c_name,\n            'image': 'alpine',\n            'ip_suffix': i + 2,\n            'limits_cpu': '1',\n            'limits_memory': '128MB'\n        })\n        # Whitebox in-container verification check (Option A)\n        verify_commands.append({\n            'target': 'container',\n            'container_name': c_name,\n            'cmd': ['echo', f'verified_{c_name}'],\n            'timeout': 15,\n            'interval': 1,\n            'retry_timeout': 10\n        })\n\n    return {\n        'challenge_id': f'ch-bench-{team_k}',\n        'team_k': team_k,\n        'containers': containers,\n        'readiness_commands': [],\n        'verify_commands': verify_commands,\n        'verify_internet_access': False\n    }\n\nclass BenchmarkRunner:\n    def __init__(self, base_url: str = 'http://127.0.0.1:8000', token: str = 'secret-token'):\n        self.client = BlueAgentTestClient(base_url=base_url, token=token, timeout=900.0)\n        self.results: List[Dict[str, Any]] = []\n\n    async def ensure_clean_environment(self, team_ids: List[int]):\n        logger.info('Performing pre-flight teardown of existing teams: %s', team_ids)\n        for k in team_ids:\n            try:\n                await self.client.teardown_challenge(team_k=k)\n            except Exception:\n                pass\n            try:\n                await self.client.delete_team(team_k=k)\n            except Exception:\n                pass\n\n    # --------------------------------------------------------------------------\n    # TEST 1: Single-Team Baseline & Micro-Phase Profiling\n    # --------------------------------------------------------------------------\n    async def run_test_1(self, cycles: int = 10):\n        logger.info('===============================================================')\n        logger.info('TEST 1: SINGLE-TEAM BASELINE & MICRO-PHASE PROFILING (N=1, M=1, %d cycles)', cycles)\n        logger.info('===============================================================')\n        \n        team_k = 1\n        await self.ensure_clean_environment([team_k])\n        \n        deploy_totals = []\n        creates = []\n        pushes = []\n        starts = []\n        runtime_nets = []\n        \n        verify_totals = []\n        ovn_creates = []\n        cow_clones = []\n        clone_starts = []\n        verify_cmds = []\n        cleanups = []\n        \n        for c in range(1, cycles + 1):\n            logger.info('[Test 1] Cycle %d/%d starting...', c, cycles)\n            # 1. Create team\n            await self.client.create_team(team_k=team_k, name=f'Baseline Team {c}')\n            payload = build_challenge_payload(team_k=team_k, num_containers=1)\n            \n            # 2. Deploy\n            t0 = time.perf_counter()\n            r_dep = await self.client.deploy_challenge(payload, team_k=team_k)\n            dep_elapsed = time.perf_counter() - t0\n            assert r_dep.status_code in (200, 201), f'Deploy failed: {r_dep.text}'\n            dep_data = r_dep.json()\n            st = dep_data.get('step_timings', {})\n            \n            deploy_totals.append(dep_elapsed)\n            creates.append(st.get('total_create_sec', 0.0))\n            pushes.append(st.get('total_push_sec', 0.0))\n            starts.append(st.get('total_start_sec', 0.0))\n            runtime_nets.append(st.get('total_runtime_net_sec', 0.0))\n            \n            # 3. Verify\n            t0 = time.perf_counter()\n            r_ver = await self.client.verify_challenge(team_k=team_k, config_payload=payload)\n            ver_elapsed = time.perf_counter() - t0\n            assert r_ver.status_code == 200, f'Verify failed: {r_ver.text}'\n            ver_data = r_ver.json()\n            v_st = ver_data.get('details', {}).get('step_timings', {})\n            sb = v_st.get('sandbox_setup', {})\n            cl = v_st.get('cleanup', {})\n            \n            verify_totals.append(ver_elapsed)\n            ovn_creates.append(sb.get('ovn_network_create_sec', 0.0))\n            cow_clones.append(sb.get('total_clone_time_sec', 0.0))\n            clone_starts.append(sb.get('total_start_time_sec', 0.0))\n            verify_cmds.append(v_st.get('verify_commands_sec', 0.0))\n            cleanups.append(cl.get('total_cleanup_sec', 0.0))\n            \n            # 4. Teardown\n            await self.client.teardown_challenge(team_k=team_k)\n            await self.client.delete_team(team_k=team_k)\n            logger.info('Cycle %d finished: Deploy=%.3fs, Verify=%.3fs', c, dep_elapsed, ver_elapsed)\n\n        res = {\n            'test_name': 'Test 1 (Baseline M=1, N=1)',\n            'teams_count': 1,\n            'containers_per_team': 1,\n            'cycles': cycles,\n            'deploy_stats': calculate_stats(deploy_totals),\n            'verify_stats': calculate_stats(verify_totals),\n            'phase_stats': {\n                'create_sec': calculate_stats(creates),\n                'push_sec': calculate_stats(pushes),\n                'start_sec': calculate_stats(starts),\n                'runtime_net_sec': calculate_stats(runtime_nets),\n                'ovn_create_sec': calculate_stats(ovn_creates),\n                'cow_clone_sec': calculate_stats(cow_clones),\n                'clone_start_sec': calculate_stats(clone_starts),\n                'verify_cmds_sec': calculate_stats(verify_cmds),\n                'cleanup_sec': calculate_stats(cleanups),\n            }\n        }\n        self.results.append(res)\n        logger.info('[+] Test 1 Completed successfully.')\n        return res\n\n    # --------------------------------------------------------------------------\n    # TEST 3: Cross-Team Concurrency Burst\n    # --------------------------------------------------------------------------\n    async def run_test_3(self, team_counts: List[int] = [2, 5, 10, 15]):\n        logger.info('===============================================================')\n        logger.info('TEST 3: CROSS-TEAM CONCURRENCY BURST (M in %s, N=2 fixed)', team_counts)\n        logger.info('===============================================================')\n        \n        for m in team_counts:\n            team_ids = list(range(1, m + 1))\n            await self.ensure_clean_environment(team_ids)\n            logger.info('[Test 3] Provisioning %d teams in parallel...', m)\n            \n            # 1. Provision teams in parallel\n            await asyncio.gather(*[\n                self.client.create_team(team_k=k, name=f'Burst Team {k}')\n                for k in team_ids\n            ])\n            \n            # 2. Deploy challenges in parallel (N=2 containers)\n            payloads = {k: build_challenge_payload(team_k=k, num_containers=2) for k in team_ids}\n            logger.info('[Test 3] Firing %d simultaneous Deploy requests...', m)\n            t_dep_start = time.perf_counter()\n            dep_responses = await asyncio.gather(*[\n                self.client.deploy_challenge(payloads[k], team_k=k)\n                for k in team_ids\n            ])\n            dep_wall_time = time.perf_counter() - t_dep_start\n            \n            dep_durations = []\n            for r in dep_responses:\n                assert r.status_code in (200, 201), f'Deploy failed in burst: {r.text}'\n                st = r.json().get('step_timings', {})\n                dep_durations.append(st.get('total_deploy_sec', 0.0))\n\n            # 3. Burst Verify requests simultaneously\n            logger.info('[Test 3] Firing %d simultaneous Verify requests...', m)\n            mem_before = get_system_metrics()\n            t_ver_start = time.perf_counter()\n            ver_responses = await asyncio.gather(*[\n                self.client.verify_challenge(team_k=k, config_payload=payloads[k])\n                for k in team_ids\n            ])\n            ver_wall_time = time.perf_counter() - t_ver_start\n            mem_after = get_system_metrics()\n            \n            ver_durations = []\n            ovn_times = []\n            clone_times = []\n            clean_times = []\n            for r in ver_responses:\n                assert r.status_code == 200, f'Verify failed in burst: {r.text}'\n                v_st = r.json().get('details', {}).get('step_timings', {})\n                ver_durations.append(v_st.get('total_verify_lifecycle_sec', 0.0))\n                sb = v_st.get('sandbox_setup', {})\n                ovn_times.append(sb.get('ovn_network_create_sec', 0.0))\n                clone_times.append(sb.get('total_clone_time_sec', 0.0))\n                clean_times.append(v_st.get('cleanup', {}).get('total_cleanup_sec', 0.0))\n            \n            # 4. Teardown\n            logger.info('[Test 3] Tearing down %d teams...', m)\n            await asyncio.gather(*[self.client.teardown_challenge(team_k=k) for k in team_ids])\n            await asyncio.gather(*[self.client.delete_team(team_k=k) for k in team_ids])\n            \n            res = {\n                'test_name': f'Test 3 (Burst M={m}, N=2)',\n                'teams_count': m,\n                'containers_per_team': 2,\n                'total_containers_live': m * 2,\n                'peak_containers_verify': m * 2 * 2,\n                'deploy_wall_time': round(dep_wall_time, 4),\n                'verify_wall_time': round(ver_wall_time, 4),\n                'deploy_stats': calculate_stats(dep_durations),\n                'verify_stats': calculate_stats(ver_durations),\n                'phase_stats': {\n                    'ovn_create_sec': calculate_stats(ovn_times),\n                    'cow_clone_sec': calculate_stats(clone_times),\n                    'cleanup_sec': calculate_stats(clean_times),\n                },\n                'ram_used_mb': mem_after['used_ram_mb']\n            }\n            self.results.append(res)\n            logger.info('[+] M=%d Burst: Deploy Wall=%.3fs, Verify Wall=%.3fs (Verify p95=%.3fs)', \n                        m, dep_wall_time, ver_wall_time, res['verify_stats']['p95'])\n\n    # --------------------------------------------------------------------------\n    # TIERED STRESS TEST: Full (M x N) Grid\n    # --------------------------------------------------------------------------\n    async def run_tiered_matrix(self, teams: List[int], containers: List[int]):\n        logger.info('===============================================================')\n        logger.info('TIERED STRESS TEST MATRIX (M in %s, N in %s)', teams, containers)\n        logger.info('===============================================================')\n        \n        for m in teams:\n            for n in containers:\n                logger.info('>>> STARTING TIER: M=%d teams, N=%d containers/team (Peak Instances: %d) <<<', \n                            m, n, 2 * m * n)\n                team_ids = list(range(1, m + 1))\n                await self.ensure_clean_environment(team_ids)\n                \n                # 1. Provision M teams concurrently\n                t_prov_start = time.perf_counter()\n                await asyncio.gather(*[\n                    self.client.create_team(team_k=k, name=f'Tier Team {k}')\n                    for k in team_ids\n                ])\n                prov_sec = time.perf_counter() - t_prov_start\n                \n                # 2. Deploy challenges concurrently across all M teams\n                payloads = {k: build_challenge_payload(team_k=k, num_containers=n) for k in team_ids}\n                t_dep_start = time.perf_counter()\n                dep_resps = await asyncio.gather(*[\n                    self.client.deploy_challenge(payloads[k], team_k=k)\n                    for k in team_ids\n                ])\n                dep_wall_sec = time.perf_counter() - t_dep_start\n                \n                dep_times = []\n                for r in dep_resps:\n                    if r.status_code not in (200, 201):\n                        logger.error('Deploy failure on team: %s', r.text)\n                    st = r.json().get('step_timings', {})\n                    dep_times.append(st.get('total_deploy_sec', dep_wall_sec))\n                \n                # 3. Verify challenges concurrently across all M teams\n                mem_before = get_system_metrics()\n                t_ver_start = time.perf_counter()\n                ver_resps = await asyncio.gather(*[\n                    self.client.verify_challenge(team_k=k, config_payload=payloads[k])\n                    for k in team_ids\n                ])\n                ver_wall_sec = time.perf_counter() - t_ver_start\n                mem_after = get_system_metrics()\n                \n                ver_times = []\n                ovn_times = []\n                clone_times = []\n                start_times = []\n                clean_times = []\n                pass_count = 0\n                \n                for r in ver_resps:\n                    if r.status_code == 200:\n                        v_json = r.json()\n                        if v_json.get('passed'):\n                            pass_count += 1\n                        v_st = v_json.get('details', {}).get('step_timings', {})\n                        ver_times.append(v_st.get('total_verify_lifecycle_sec', ver_wall_sec))\n                        sb = v_st.get('sandbox_setup', {})\n                        ovn_times.append(sb.get('ovn_network_create_sec', 0.0))\n                        clone_times.append(sb.get('total_clone_time_sec', 0.0))\n                        start_times.append(sb.get('total_start_time_sec', 0.0))\n                        clean_times.append(v_st.get('cleanup', {}).get('total_cleanup_sec', 0.0))\n                    else:\n                        logger.error('Verify error: %s', r.text)\n                \n                # 4. Clean Teardown\n                t_tear_start = time.perf_counter()\n                await asyncio.gather(*[self.client.teardown_challenge(team_k=k) for k in team_ids])\n                await asyncio.gather(*[self.client.delete_team(team_k=k) for k in team_ids])\n                tear_sec = time.perf_counter() - t_tear_start\n                \n                tier_res = {\n                    'test_name': f'Tier M={m} N={n}',\n                    'teams_count': m,\n                    'containers_per_team': n,\n                    'total_containers_live': m * n,\n                    'peak_containers_verify': 2 * m * n,\n                    'deploy_wall_sec': round(dep_wall_sec, 4),\n                    'verify_wall_sec': round(ver_wall_sec, 4),\n                    'passed_ratio': f'{pass_count}/{m}',\n                    'deploy_stats': calculate_stats(dep_times),\n                    'verify_stats': calculate_stats(ver_times),\n                    'phase_stats': {\n                        'ovn_create_sec': calculate_stats(ovn_times),\n                        'cow_clone_sec': calculate_stats(clone_times),\n                        'clone_start_sec': calculate_stats(start_times),\n                        'cleanup_sec': calculate_stats(clean_times),\n                    },\n                    'ram_used_mb': mem_after['used_ram_mb']\n                }\n                self.results.append(tier_res)\n                logger.info('[+] Completed Tier M=%d, N=%d: DeployWall=%.3fs, VerifyWall=%.3fs, Verify_p95=%.3fs, RAM=%dMB',\n                            m, n, dep_wall_sec, ver_wall_sec, tier_res['verify_stats']['p95'], mem_after['used_ram_mb'])\n\n    def export_csv(self, filename: str = CSV_OUTPUT_PATH):\n        Path(filename).parent.mkdir(parents=True, exist_ok=True)\n        with open(filename, 'w', newline='') as f:\n            writer = csv.writer(f)\n            writer.writerow([\n                'Test Name', 'Teams (M)', 'Containers/Team (N)', 'Live Containers', 'Peak Verify Containers',\n                'Deploy Wall (s)', 'Deploy Avg (s)', 'Deploy p50 (s)', 'Deploy p95 (s)',\n                'Verify Wall (s)', 'Verify Avg (s)', 'Verify p50 (s)', 'Verify p95 (s)',\n                'OVN Create Avg (s)', 'CoW Clone Avg (s)', 'Clone Start Avg (s)', 'Cleanup Avg (s)',\n                'RAM Used (MB)'\n            ])\n            for r in self.results:\n                writer.writerow([\n                    r.get('test_name'),\n                    r.get('teams_count'),\n                    r.get('containers_per_team'),\n                    r.get('total_containers_live', r.get('teams_count', 0) * r.get('containers_per_team', 0)),\n                    r.get('peak_containers_verify', 2 * r.get('teams_count', 0) * r.get('containers_per_team', 0)),\n                    r.get('deploy_wall_sec', r.get('deploy_stats', {}).get('avg', 0)),\n                    r.get('deploy_stats', {}).get('avg', 0),\n                    r.get('deploy_stats', {}).get('p50', 0),\n                    r.get('deploy_stats', {}).get('p95', 0),\n                    r.get('verify_wall_sec', r.get('verify_stats', {}).get('avg', 0)),\n                    r.get('verify_stats', {}).get('avg', 0),\n                    r.get('verify_stats', {}).get('p50', 0),\n                    r.get('verify_stats', {}).get('p95', 0),\n                    r.get('phase_stats', {}).get('ovn_create_sec', {}).get('avg', 0),\n                    r.get('phase_stats', {}).get('cow_clone_sec', {}).get('avg', 0),\n                    r.get('phase_stats', {}).get('clone_start_sec', {}).get('avg', 0),\n                    r.get('phase_stats', {}).get('cleanup_sec', {}).get('avg', 0),\n                    r.get('ram_used_mb', 0)\n                ])\n        logger.info('[+] Exported CSV to %s', filename)\n\n    def export_markdown_report(self, filename: str = REPORT_OUTPUT_PATH):\n        Path(filename).parent.mkdir(parents=True, exist_ok=True)\n        now_str = datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M:%S UTC')\n        with open(filename, 'w') as f:\n            f.write('# BlueAgent System Stress & Scalability Benchmark Report\\n\\n')\n            f.write(f'*Generated on:* `{now_str}` on AMD Ryzen 7 7700X (8 Cores), 15 GiB RAM\\n\\n')\n            f.write('## 1. Summary of Benchmark Results\\n\\n')\n            f.write('| Scenario | Teams (M) | Containers (N) | Peak Instances | Deploy Wall (s) | Deploy p95 (s) | Verify Wall (s) | Verify p95 (s) | CoW Clone (s) | OVN Create (s) | RAM (MB) |\\n')\n            f.write('| :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- |\\n')\n            for r in self.results:\n                f.write(f\"| {r.get('test_name')} | {r.get('teams_count')} | {r.get('containers_per_team')} | {r.get('peak_containers_verify', 2 * r.get('teams_count', 0) * r.get('containers_per_team', 0))} | {r.get('deploy_wall_sec', '-')} | {r.get('deploy_stats', {}).get('p95', '-')} | {r.get('verify_wall_sec', '-')} | {r.get('verify_stats', {}).get('p95', '-')} | {r.get('phase_stats', {}).get('cow_clone_sec', {}).get('avg', '-')} | {r.get('phase_stats', {}).get('ovn_create_sec', {}).get('avg', '-')} | {r.get('ram_used_mb', '-')} |\\n\")\n            f.write('\\n## 2. Raw JSON Dataset\\n\\n```json\\n')\n            f.write(json.dumps(self.results, indent=2))\n            f.write('\\n```\\n')\n        logger.info('[+] Exported Markdown Report to %s', filename)\n\nasync def main():\n    parser = argparse.ArgumentParser(description='BlueAgent Thesis Stress Benchmark Suite')\n    parser.add_argument('--test', choices=['1', '3', 'matrix', 'all'], default='all',\n                        help='Which test to run: 1 (Baseline), 3 (Burst), matrix (Tiered Grid), or all')\n    parser.add_argument('--m', nargs='+', type=int, default=[2, 5, 10, 15], help='Teams M list')\n    parser.add_argument('--n', nargs='+', type=int, default=[2, 5, 7, 10], help='Containers N list')\n    parser.add_argument('--cycles', type=int, default=10, help='Cycles for Test 1')\n    args = parser.parse_args()\n\n    runner = BenchmarkRunner()\n    \n    # Pre-test server health check\n    ready = await runner.client.wait_server_ready(max_seconds=10.0)\n    if not ready:\n        logger.error('BlueAgent server is not responding on http://127.0.0.1:8000')\n        sys.exit(1)\n\n    t_suite_start = time.perf_counter()\n\n    if args.test in ('1', 'all'):\n        await runner.run_test_1(cycles=args.cycles)\n\n    if args.test in ('3', 'all'):\n        await runner.run_test_3(team_counts=args.m)\n\n    if args.test in ('matrix', 'all'):\n        await runner.run_tiered_matrix(teams=args.m, containers=args.n)\n\n    runner.export_csv()\n    runner.export_markdown_report()\n    total_elapsed = time.perf_counter() - t_suite_start\n    logger.info('[*] Entire Benchmark Suite Finished in %.2f seconds (%.2f minutes)', total_elapsed, total_elapsed / 60)\n\nif __name__ == '__main__':\n    asyncio.run(main())\nEOF\"","Cwd":"/home/davidel","IsDaemon":false,"RunPersistent":false,"WaitMsBeforeAsync":5000,"toolAction":"Writing benchmark_suite.py script","toolSummary":"Create benchmark_suite.py"}}]}
