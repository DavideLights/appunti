{"step_index":64,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-16T16:30:01Z","content":"Created At: 2026-10-16T18:30:01+02:00\nCompleted At: 2026-10-16T18:30:03+02:00\n\nThe command exited with code 0.\nOutput:\n<truncated 1 lines>\n\r\nfrom datetime import datetime, timezone\r\nimport logging\r\nimport time\r\nfrom typing import List, Optional\r\n\r\nfrom ..config import settings\r\nfrom ..database import DatabaseManager\r\nfrom ..engine.base import ContainerEngine\r\nfrom ..incus import devices\r\nfrom ..locks import LockRegistry, LockTimeoutError\r\nfrom ..models import (\r\n    ChallengeConfig,\r\n    DeployResponse,\r\n    RunningContainerRecord,\r\n    VerifyResultResp,\r\n)\r\nfrom ..network.commands import ip\r\nfrom ..network.host_net import HostNetworkManager\r\nfrom ..network.templates import render_interfaces_conf, render_networkd_conf\r\nfrom ..verifier.ovn import OVNVerifier\r\n\r\nlogger = logging.getLogger(__name__)\r\n\r\n\r\nclass ChallengeServiceError(Exception):\r\n    \"\"\"Base exception for challenge service operations.\"\"\"\r\n\r\n\r\nclass TeamNotFoundError(ChallengeServiceError):\r\n    \"\"\"Raised when the specified team does not exist.\"\"\"\r\n\r\n\r\nclass BridgeNotActiveError(ChallengeServiceError):\r\n    \"\"\"Raised when the team production bridge is not active.\"\"\"\r\n\r\n\r\nclass ImageNotReadyError(ChallengeServiceError):\r\n    \"\"\"Raised when a container image is not ready or missing.\"\"\"\r\n\r\n\r\nclass DeploymentRollbackError(ChallengeServiceError):\r\n    \"\"\"Raised when deployment fails and rollback succeeds.\"\"\"\r\n\r\n\r\nclass DeploymentFailedError(ChallengeServiceError):\r\n    \"\"\"Raised when deployment fails and rollback also encounters errors.\"\"\"\r\n\r\n\r\nclass VerificationLockedError(ChallengeServiceError):\r\n    \"\"\"Raised when verification cannot acquire required locks.\"\"\"\r\n\r\n\r\nclass TeardownError(ChallengeServiceError):\r\n    \"\"\"Raised when container or state teardown fails.\"\"\"\r\n\r\n\r\nasync def teardown_challenge(\r\n    challenge_id: str,\r\n    team_k: int,\r\n    db: DatabaseManager,\r\n    engine: ContainerEngine,\r\n    container_names: Optional[List[str]] = None,\r\n) -> None:\r\n    \"\"\"Tears down container instances and clears database state.\r\n\r\n    If container_names is provided, only those specific containers are torn down.\r\n    Otherwise, all containers for team_k are torn down.\r\n    Expects caller to manage locks.\r\n    \"\"\"\r\n    targets = []\r\n    if container_names:\r\n        for name in container_names:\r\n            c = await db.get_container_by_spec(team_k, name)\r\n            if c:\r\n                targets.append(c)\r\n            else:\r\n                c_full = await db.get_container(name)\r\n                if c_full and c_full.team_k == team_k:\r\n                    targets.append(c_full)\r\n                else:\r\n                    full_name = f\"c-{team_k}-{name}\"\r\n                    targets.append(type(\"TempTarget\", (), {\"instance_name\": full_name})())\r\n    else:\r\n        targets = await db.list_team_containers(team_k)\r\n\r\n    errors = []\r\n    for inst in targets:\r\n        try:\r\n            logger.info(\"Stopping and deleting instance '%s'\", inst.instance_name)\r\n            await engine.delete_instance(inst.instance_name, force=True)\r\n            await db.delete_container(inst.instance_name)\r\n        except Exception as exc:\r\n            logger.warning(\"Error deleting instance '%s': %s\", inst.instance_name, exc)\r\n            errors.append(f\"{inst.instance_name}: {exc}\")\r\n\r\n    if errors:\r\n        err_msg = \"; \".join(errors)\r\n        raise TeardownError(f\"Failed to teardown containers for team {team_k}: {err_msg}\")\r\n\r\n    logger.info(\"Containers for team %d successfully torn down.\", team_k)\r\n\r\n\r\nclass ChallengeService:\r\n    \"\"\"Orchestrates challenge deployment, container lifecycle, and sandbox verification.\"\"\"\r\n\r\n    def __init__(\r\n        self,\r\n        db: DatabaseManager,\r\n        engine: ContainerEngine,\r\n        host_net: HostNetworkManager,\r\n        locks: LockRegistry,\r\n    ):\r\n        self.db = db\r\n        self.engine = engine\r\n        self.host_net = host_net\r\n        self.locks = locks\r\n\r\n    async def deploy_challenge(self, team_k: int, config: ChallengeConfig) -> DeployResponse:\r\n=== OVN TOP ===\r\n\"\"\"OVN dark sandbox verification orchestrator template.\r\n\r\nActs as an Asynchronous Context Manager (RAII) coordinating:\r\n1. Creation of dark OVN logical switch.\r\n2. Fast CoW cloning of production target containers.\r\n3. Rebinding container eth0 NIC from live bridge to OVN switch.\r\n4. Optional provisioning of ephemeral verifier runner.\r\n5. In-situ and black-box probe execution.\r\n6. Guaranteed reverse-order teardown.\r\n\"\"\"\r\n\r\nimport asyncio\r\nimport time\r\nfrom typing import Any, Dict, List, Optional\r\nfrom ..config import settings\r\nfrom ..engine.base import ContainerEngine\r\nfrom ..incus import devices\r\nfrom ..models import ChallengeConfig, VerifyResultResp, ContainerSpec\r\nfrom ..network.commands import ip\r\nfrom ..network.templates import render_interfaces_conf, render_networkd_conf\r\n\r\n\r\n\r\nclass OVNVerifier:\r\n    \"\"\"Async context manager managing OVN sandbox lifecycle and verifier runners.\r\n\r\n    NOTE: This is an architectural template to be populated in Phase 2.\r\n    \"\"\"\r\n\r\n    def __init__(self, engine: ContainerEngine, config: ChallengeConfig, session_id: str, team_k: Optional[int] = None):\r\n        self.engine = engine\r\n        self.config = config\r\n        self.session_id = session_id[:4] if len(session_id) > 4 else session_id\r\n        if team_k is not None:\r\n            self.team_k = team_k\r\n        elif hasattr(config, \"team_k\") and getattr(config, \"team_k\") is not None:\r\n            self.team_k = getattr(config, \"team_k\")\r\n        else:\r\n            raise ValueError(\"team_k must be provided to OVNVerifier\")\r\n        self.net_name = f\"verify-{self.team_k}\"\r\n        self.clones: List[str] = []\r\n        self.verifier_container_name: Optional[str] = None\r\n        self.step_timings: Dict[str, Any] = {}\r\n        self._t_start = time.perf_counter()\r\n\r\n    async def __aenter__(self) -> \"OVNVerifier\":\r\n        \"\"\"Provisions the dark OVN network and CoW clones the target instances.\"\"\"\r\n        try:\r\n            t_enter = time.perf_counter()\r\n            net_config = {\r\n                \"network\": \"incusbr0\",\r\n                \"ipv4.address\": f\"10.{self.team_k}.1.1/24\",\r\n                \"ipv4.nat\": \"true\",\r\n            }\r\n\r\n            t0 = time.perf_counter()\r\n            await self.engine.create_network(\r\n                name=self.net_name,\r\n                config=net_config,\r\n            )\r\n            ovn_net_sec = time.perf_counter() - t0\r\n\r\n            clone_timings: List[dict] = []\r\n            for c in self.config.containers:\r\n                c_t0 = time.perf_counter()\r\n                source_name = f\"c-{self.team_k}-{c.name}\"\r\n                clone_name = f\"verify-{self.team_k}-{c.name}\"\r\n                ip_addr = f\"10.{self.team_k}.1.{c.ip_suffix}\"\r\n                gw_ip = f\"10.{self.team_k}.1.1\"\r\n\r\n                t_cl = time.perf_counter()\r\n                await self.engine.clone_instance(source_name, clone_name)\r\n                clone_sec = time.perf_counter() - t_cl\r\n\r\n                t_conn = time.perf_counter()\r\n                await self.engine.connect_network(clone_name, self.net_name)\r\n                conn_sec = time.perf_counter() - t_conn\r\n\r\n                t_st = time.perf_counter()\r\n                await self.engine.start_instance(clone_name)\r\n                start_sec = time.perf_counter() - t_st\r\n                self.clones.append(clone_name)\r\n\r\n                # Ensure runtime IP and route are active\r\n                t_net = time.perf_counter()\r\n                try:\r\n                    await self.engine.exec_command(clone_name, ip.addr_replace(f\"{ip_addr}/24\", \"eth0\"))\r\n                    await self.engine.exec_command(clone_name, ip.link_up(\"eth0\"))\r\n                    await self.engine.exec_command(clone_name, ip.route_replace_default(gw_ip, \"eth0\"))\r\n                except Exception:\r\n                    pass\r\n                runtime_net_sec = time.perf_counter() - t_net\r\n\r\n                clone_timings.append({\r\n                    \"clone\": clone_name,\r\n                    \"clone_sec\": round(clone_sec, 4),\r\n                    \"connect_sec\": round(conn_sec, 4),\r\n                    \"start_sec\": round(start_sec, 4),\r\n                    \"runtime_net_sec\": round(runtime_net_sec, 4),\r\n                    \"total_clone_sec\": round(time.perf_counter() - c_t0, 4),\r\n\n"}
