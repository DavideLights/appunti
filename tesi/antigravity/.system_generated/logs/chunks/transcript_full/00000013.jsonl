{"step_index":685,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-16T20:11:08Z","content":"Created At: 2026-10-16T22:11:08+02:00\nCompleted At: 2026-10-16T22:11:08+02:00\nFile Path: `file:///home/davidel/.gemini/antigravity/brain/335ea41a-df46-4ffa-bb4c-eefc5a5248cd/scratch/plot_graphs_3_4_5.py`\nTotal Lines: 239\nTotal Bytes: 10547\nShowing lines 120 to 239\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n120:     # Label colors and vertical lines for barriers\n121:     phase_colors = {\n122:         'provision_teams': '#e9c46a',\n123:         'deploy_challenges': '#f4a261',\n124:         'verify_setup': '#e76f51',\n125:         'verify_cleanup': '#2a9d8f',\n126:         'teardown_machines': '#264653',\n127:         'teardown_teams': '#457b9d',\n128:     }\n129: \n130:     phase_display_names = {\n131:         'provision_teams': 'Barrier 1:\\nProvision Teams',\n132:         'deploy_challenges': 'Barrier 2:\\nDeploy Challenges\\n(50 Live Containers)',\n133:         'verify_setup': 'Barrier 3:\\nVerify Setup\\n(100 Containers Alive!)',\n134:         'verify_cleanup': 'Barrier 4:\\nVerify Cleanup',\n135:         'teardown_machines': 'Barrier 5:\\nTeardown Containers',\n136:         'teardown_teams': 'Barrier 6:\\nTeardown Teams',\n137:     }\n138: \n139:     # Add phase demarcation lines\n140:     for i in range(len(step_transitions)):\n141:         t_start, s_name = step_transitions[i]\n142:         t_end = step_transitions[i+1][0] if i + 1 < len(step_transitions) else t[-1]\n143:         t_mid = (t_start + t_end) / 2\n144: \n145:         ax_cpu.axvline(t_start, color='gray', linestyle=':', alpha=0.7)\n146:         if s_name in ('deploy_challenges', 'verify_setup', 'verify_cleanup', 'teardown_machines'):\n147:             ax_cpu.text(t_mid, 92, phase_display_names[s_name], ha='center', va='top',\n148:                         fontsize=8.5, fontweight='bold',\n149:                         bbox=dict(boxstyle='round,pad=0.3', facecolor='white', edgecolor='gray', alpha=0.85))\n150: \n151:     ax_cpu.set_title('Graph 4: Host Lifecycle Telemetry Timeline (Tier M=10 Teams, N=5 Containers — Peak 100 Instances)',\n152:                      fontweight='bold', pad=14)\n153:     ax_cpu.set_xlabel('Elapsed Time from Scenario Start (Seconds)')\n154:     ax_cpu.set_ylabel('CPU Utilization (% Across 8 Cores)', color='#264653', fontweight='bold')\n155:     ax_ram.set_ylabel('Net Container RAM Delta (+MB Over Baseline)', color='#e76f51', fontweight='bold')\n156: \n157:     ax_cpu.set_ylim(0, 100)\n158:     ax_ram.set_ylim(-200, 6000)\n159: \n160:     ax_cpu.tick_params(axis='y', labelcolor='#264653')\n161:     ax_ram.tick_params(axis='y', labelcolor='#e76f51')\n162:     ax_cpu.grid(True)\n163: \n164:     # Combined legend\n165:     lines = l1 + l2\n166:     labels = [l.get_label() for l in lines]\n167:     ax_cpu.legend(lines, labels, loc='upper left', framealpha=0.95)\n168: \n169:     plt.tight_layout()\n170:     png_path = OUTPUT_DIR / 'graph4_lifecycle_timeline.png'\n171:     pdf_path = OUTPUT_DIR / 'graph4_lifecycle_timeline.pdf'\n172:     plt.savefig(png_path, dpi=300, bbox_inches='tight')\n173:     plt.savefig(pdf_path, bbox_inches='tight')\n174:     plt.close()\n175:     print(f'[+] Graph 4 saved to {png_path} and {pdf_path}')\n176: \n177: \n178: # ==============================================================================\n179: # GRAPH 5: Per-Step CPU & I/O Wait Utilization (Grouped Bar Chart)\n180: # ==============================================================================\n181: def generate_graph_5():\n182:     df_step_ubu = pd.read_csv(BASE_DIR / 'thesis_ubuntu_step_resources.csv')\n183:     df_step_alp = pd.read_csv(BASE_DIR / 'thesis_alpine_step_resources.csv')\n184: \n185:     # Filter for the peak scale scena