st_name') != test_name]\n136:         self.raw_samples.extend(tier_samples)\n137: \n138:         # Immediately flush all outputs so no progress is ever lost\n139:         self.save_state_json()\n140:         self.export_summary_csv()\n141:         self.export_raw_samples_csv()\n142:         self.export_markdown_report()\n143: \n144:     def save_state_json(self, filename: str = STATE_JSON_PATH):\n145:         Path(filename).parent.mkdir(parents=True, exist_ok=True)\n146:         with open(filename, 'w') as f:\n147:             json.dump({'results': self.results, 'raw_samples': self.raw_samples}, f, indent=2)\n148: \n149:     async def ensure_clean_environment(self, team_ids: List[int]):\n150:         \"\"\"Parallel cleanup of BlueAgent teams + direct Incus sweep of any orphaned verify-* resources.\"\"\"\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
